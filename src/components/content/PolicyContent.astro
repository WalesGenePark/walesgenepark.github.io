---
import type { PrivacyEntry, CookiesEntry } from '~/types/content';

interface Props {
  entry: PrivacyEntry | CookiesEntry;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<article class="mx-auto max-w-4xl px-4 py-16 lg:py-20">
  <div class="mb-10">
    <h1 class="text-center font-bold leading-tighter tracking-tighter font-heading text-4xl md:text-5xl">
      {entry.data.title}
    </h1>

    {
      entry.data.description && (
        <div class="text-center mt-4 text-xl text-gray-600 dark:text-slate-400">{entry.data.description}</div>
      )
    }
  </div>

  <div class="mx-auto prose dark:prose-invert max-w-4xl">
    <Content />
  </div>
</article>
