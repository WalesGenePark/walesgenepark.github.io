---
import type { ContentEntry, NewsEntry, EventEntry, TeamEntry, PrivacyEntry, CookiesEntry } from '~/types/content';
import NewsContent from './NewsContent.astro';
import EventContent from './EventContent.astro';
import TeamContent from './TeamContent.astro';
import PolicyContent from './PolicyContent.astro';

interface Props {
  entry: ContentEntry;
}

const { entry } = Astro.props;

// Type guard functions
const isNewsEntry = (entry: ContentEntry): entry is NewsEntry => entry.collection === 'news';
const isEventEntry = (entry: ContentEntry): entry is EventEntry => entry.collection === 'events';
const isTeamEntry = (entry: ContentEntry): entry is TeamEntry => entry.collection === 'team';
const isPolicyEntry = (entry: ContentEntry): entry is PrivacyEntry | CookiesEntry =>
  entry.collection === 'privacy' || entry.collection === 'cookies';
---

{
  (() => {
    if (isNewsEntry(entry)) return <NewsContent entry={entry} />;
    if (isEventEntry(entry)) return <EventContent entry={entry} />;
    if (isTeamEntry(entry)) return <TeamContent entry={entry} />;
    if (isPolicyEntry(entry)) return <PolicyContent entry={entry} />;
    return null;
  })()
}
