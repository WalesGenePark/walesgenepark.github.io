---
import { Icon } from 'astro-icon/components';

interface Props {
  events: any[];
  lang: string;
  currentMonth: number;
  currentYear: number;
}

const { events, lang, currentMonth, currentYear } = Astro.props;

function getDaysInMonth(month: number, year: number) {
  return new Date(year, month + 1, 0).getDate();
}

function getFirstDayOfMonth(month: number, year: number) {
  return new Date(year, month, 1).getDay();
}

const daysInMonth = getDaysInMonth(currentMonth, currentYear);
const firstDay = getFirstDayOfMonth(currentMonth, currentYear);

const weekDays = {
  en: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
  cy: ['Sul', 'Llun', 'Maw', 'Mer', 'Iau', 'Gwe', 'Sad'],
};

const days = Array.from({ length: daysInMonth }, (_, i) => i + 1);
const blanks = Array.from({ length: firstDay }, (_, i) => i);

// Group events by day
const eventsMap = events.reduce((acc, event) => {
  const date = new Date(event.data.date);
  if (date.getMonth() === currentMonth && date.getFullYear() === currentYear) {
    const day = date.getDate();
    if (!acc[day]) acc[day] = [];
    acc[day].push(event);
  }
  return acc;
}, {} as Record<number, typeof events>);

// Sort events by time for each day
Object.values(eventsMap).forEach(dayEvents => {
  dayEvents.sort((a, b) => {
    const timeA = a.data.startTime || '';
    const timeB = b.data.startTime || '';
    return timeA.localeCompare(timeB);
  });
});

const today = new Date();
const isPastDay = (day: number) => {
  const date = new Date(currentYear, currentMonth, day);
  return date < new Date(today.getFullYear(), today.getMonth(), today.getDate());
};
---

<div class="calendar-grid bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden">
  <div class="calendar-weekdays grid grid-cols-7 bg-gray-100 dark:bg-gray-700">
    {weekDays[lang as keyof typeof weekDays].map((day) => (
      <div class="p-2 text-center text-sm font-medium">{day}</div>
    ))}
  </div>
  
  <div class="calendar-days grid grid-cols-7">
    {blanks.map(() => (
      <div class="calendar-day p-2 min-h-[120px] border border-gray-200 dark:border-gray-700"></div>
    ))}
    
    {days.map((day) => {
      const past = isPastDay(day);
      return (
        <div class={`calendar-day p-2 min-h-[120px] border border-gray-200 dark:border-gray-700 ${
          past ? 'past-day' : ''
        }`}>
          <div class={`text-sm font-medium mb-2 ${
            past ? 'text-gray-400 dark:text-gray-600' : ''
          }`}>{day}</div>
          <div class="space-y-1">
            {eventsMap[day]?.map((event) => {
              const startTime = event.data.startTime || '';
              const endTime = event.data.endTime || '';
              const timeDisplay = startTime && endTime ? `${startTime} - ${endTime}` : startTime || '';
              
              return (
                <a
                  href={`/${lang}/calendar/${event.slug.split('/')[1]}`}
                  class={`block p-1 rounded hover:bg-gray-50 dark:hover:bg-gray-800 group ${
                    past ? 'opacity-50' : ''
                  }`}
                >
                  {timeDisplay && (
                    <div class="text-xs text-primary font-medium mb-0.5">{timeDisplay}</div>
                  )}
                  <div class="text-xs font-medium text-gray-900 dark:text-gray-100 group-hover:text-primary">
                    {event.data.title}
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      );
    })}
  </div>
</div>

<style>
.calendar-grid {
  @apply w-full;
}

.calendar-weekdays {
  @apply border-b border-gray-200 dark:border-gray-700;
}

.calendar-day {
  @apply relative transition-colors duration-150;
}

.calendar-day:not(.past-day):hover {
  @apply bg-gray-50 dark:bg-gray-800;
}

.past-day {
  @apply bg-gray-50 dark:bg-gray-900;
}

.calendar-day > div:first-child {
  @apply sticky top-0 bg-inherit z-10;
}
</style>
