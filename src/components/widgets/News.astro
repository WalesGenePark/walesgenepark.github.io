---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import type { LanguageCode } from '~/i18n/routes';
import type { NewsEntry } from '~/types/content';

const currentLang = getLangFromUrl(Astro.url) as LanguageCode;
const t = useTranslations(currentLang);

const news = (await getCollection('news', ({ id }) => {
  return id.startsWith(currentLang + '/');
})) as NewsEntry[];

// Sort news by publishDate
const sortedNews = news.sort((a, b) => {
  return new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
});

const formatNewsDate = (date: Date) => {
  return date.toLocaleDateString(currentLang === 'cy' ? 'cy' : 'en-GB', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

// Function to truncate text to first 30 words
const truncateText = (text: string, wordLimit: number = 30) => {
  const words = text.split(' ');
  if (words.length <= wordLimit) return text;
  return words.slice(0, wordLimit).join(' ') + '...';
};

// Function to generate the news article URL
const getNewsUrl = (article: NewsEntry) => {
  const slugParts = article.slug.split('/');
  return `/${currentLang}/news/${slugParts.slice(1).join('/')}`;
};
---

<section class="px-4 mx-auto max-w-4xl">
  <header class="py-16 lg:py-20">
    <h2
      class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading text-red-500 dark:text-red-500 text-center"
    >
      {t('news.title')}
    </h2>
  </header>

  {
    sortedNews.length === 0 ? (
      <p class="text-gray-600 dark:text-gray-400">{t('news.noNews')}</p>
    ) : (
      <div class="space-y-8 pb-16 lg:pb-20">
        {sortedNews.map((article) => {
          const articleUrl = getNewsUrl(article);
          return (
            <div class="border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden hover:shadow-lg hover:border-primary-300 dark:hover:border-primary-700 transition-all duration-300 ease-in-out">
              <div class="flex flex-col md:flex-row h-full">
                {article.data.image && (
                  <div class="md:w-1/3 h-48 md:h-auto">
                    <img
                      src={article.data.image}
                      class="w-full h-full object-cover"
                      alt={article.data.description || ''}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}
                <div class="p-6 flex-1">
                  <h3 class="text-xl font-bold mb-2">
                    <a
                      href={articleUrl}
                      class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-200"
                    >
                      {article.data.title}
                    </a>
                  </h3>
                  <div class="text-sm text-gray-500 dark:text-gray-400 mb-4">
                    <time datetime={article.data.publishDate.toISOString()}>
                      {formatNewsDate(article.data.publishDate)}
                    </time>
                    {article.data.author && (
                      <>
                        <span class="mx-2">•</span>
                        <span>{article.data.author}</span>
                      </>
                    )}
                  </div>
                  {article.data.description && (
                    <p class="text-gray-600 dark:text-gray-400 mb-4">{truncateText(article.data.description)}</p>
                  )}
                  <a
                    href={articleUrl}
                    class="text-primary-600 dark:text-primary-400 hover:underline inline-flex items-center"
                  >
                    {t('news.readMore')}
                    <svg class="w-5 h-5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 8l4 4m0 0l-4 4m4-4H3"
                      />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    )
  }
</section>
