---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import type { LanguageCode } from '~/i18n/routes';

const currentLang = getLangFromUrl(Astro.url) as LanguageCode;
const t = useTranslations(currentLang);

const news = await getCollection('news', ({ id }) => {
  return id.startsWith(currentLang + '/');
});

// Sort news by publishDate
const sortedNews = news.sort((a, b) => {
  return new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
});

const formatNewsDate = (date: Date) => {
  return date.toLocaleDateString(currentLang === 'cy' ? 'cy' : 'en-GB', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};

// Function to truncate text to first 30 words
const truncateText = (text: string, wordLimit: number = 30) => {
  const words = text.split(' ');
  if (words.length <= wordLimit) return text;
  return words.slice(0, wordLimit).join(' ') + '...';
};
---

<section class="px-4 py-16 mx-auto max-w-4xl lg:py-20">
  <div class="mb-10">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl sm:leading-none group font-heading mb-8">
      {t('news.title')}
    </h2>

    {sortedNews.length === 0 ? (
      <p class="text-gray-600 dark:text-gray-400">{t('news.noNews')}</p>
    ) : (
      <ul class="space-y-8">
        {sortedNews.map((article) => (
          <li class="border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden hover:shadow-lg hover:border-primary-300 dark:hover:border-primary-700 transition-all duration-300 ease-in-out">
            <div class="flex flex-col md:flex-row">
              {article.data.image ? (
                <div class="md:w-1/3 relative h-48 md:h-full min-h-[200px]">
                  <img
                    src={article.data.image}
                    class="absolute inset-0 w-full h-full object-cover"
                    alt={article.data.title}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              ) : (
                <div class="md:w-1/3 bg-gray-100 dark:bg-gray-800 min-h-[200px] flex items-center justify-center">
                  <span class="text-gray-400 dark:text-gray-600 text-lg">{t('news.noImage')}</span>
                </div>
              )}
              
              <div class="flex-1 p-6">
                <h3 class="mb-2 text-xl font-bold leading-snug font-heading">
                  <a
                    href={article.data.fullArticleLink || `/${currentLang}/news/${article.slug.split('/').slice(1).join('/')}`}
                    class="hover:text-primary-600 underline underline-offset-4 decoration-1 decoration-dotted transition ease-in duration-200"
                  >
                    {article.data.title}
                  </a>
                </h3>
                
                {article.data.description && (
                  <p class="text-gray-700 dark:text-gray-300 mb-4">
                    {truncateText(article.data.description)}
                  </p>
                )}
                
                <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-gray-600 dark:text-gray-400">
                  {article.data.publishDate && (
                    <div class="flex items-center">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                      <span>{formatNewsDate(new Date(article.data.publishDate))}</span>
                    </div>
                  )}
                  
                  {article.data.author && (
                    <div class="flex items-center">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                      </svg>
                      <span>{article.data.author}</span>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>
