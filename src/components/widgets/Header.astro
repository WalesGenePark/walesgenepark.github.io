---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '~/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  {
    text: t('nav.home'),
    href: `/${lang}`,
  },
  {
    text: t('nav.team'),
    href: `/${lang}/team`,
  },
  {
    text: t('nav.events'),
    href: `/${lang}/events`,
  },
  {
    text: t('nav.news'),
    href: `/${lang}/news`,
  },
  {
    text: t('nav.contact'),
    href: `/${lang}/contact`,
  },
];

const currentPath = Astro.url.pathname;
const enUrl = getLocalizedPath(currentPath, 'en');
const cyUrl = getLocalizedPath(currentPath, 'cy');

const socialLinks = [
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/company/wales-gene-park',
    icon: 'tabler:brand-linkedin',
  },
  {
    name: 'Twitter',
    href: 'https://twitter.com/walesgenepark',
    icon: 'tabler:brand-twitter',
  },
];
---

<header class="sticky top-0 z-40 w-full bg-white dark:bg-slate-900 border-b dark:border-b-0">
  <div class="py-3 px-3 mx-auto w-full flex justify-between items-center max-w-6xl">
    <!-- Logo -->
    <div class="flex-none">
      <a href={`/${lang}`} class="flex">
        <Logo />
      </a>
    </div>

    <!-- Desktop Menu -->
    <nav class="hidden xl:flex items-center gap-6">
      <ul class="flex items-center gap-6">
        {
          links.map(({ text, href }) => (
            <li>
              <a
                href={href}
                class="text-sm font-medium text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white"
              >
                {text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Desktop Actions -->
    <div class="hidden xl:flex items-center gap-4">
      {socialLinks.map(({ name, href, icon }) => (
        <a
          href={href}
          class="text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
          title={name}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name={icon} class="w-5 h-5" />
        </a>
      ))}

      <div class="flex items-center gap-1 text-sm">
        <a
          href={enUrl}
          class={`px-1 ${lang === 'en' ? 'text-primary font-bold' : 'text-gray-600 dark:text-gray-400'}`}
        >
          EN
        </a>
        <span class="text-gray-400">|</span>
        <a
          href={cyUrl}
          class={`px-1 ${lang === 'cy' ? 'text-primary font-bold' : 'text-gray-600 dark:text-gray-400'}`}
        >
          CY
        </a>
      </div>

      <ToggleTheme iconClass="w-5 h-5" />
    </div>

    <!-- Mobile Menu Button -->
    <button
      type="button"
      class="xl:hidden text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
      aria-label="Toggle Menu"
      data-toggle-menu
    >
      <Icon name="tabler:menu" class="w-6 h-6" />
    </button>
  </div>

  <!-- Mobile Menu Panel -->
  <div
    id="mobile-menu"
    class="xl:hidden fixed inset-0 z-50 bg-white dark:bg-slate-900 transform translate-x-full transition-transform duration-300 ease-in-out"
  >
    <div class="flex flex-col h-full">
      <div class="flex justify-between items-center p-4 border-b dark:border-gray-800">
        <span class="text-lg font-bold">Menu</span>
        <button
          type="button"
          class="text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
          aria-label="Close Menu"
          data-close-menu
        >
          <Icon name="tabler:x" class="w-6 h-6" />
        </button>
      </div>

      <nav class="flex-grow overflow-y-auto p-4">
        <ul class="space-y-4">
          {
            links.map(({ text, href }) => (
              <li>
                <a
                  href={href}
                  class="block text-lg font-medium text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white"
                >
                  {text}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="mt-8 pt-8 border-t dark:border-gray-800">
          <div class="flex justify-center gap-4 mb-4">
            {socialLinks.map(({ name, href, icon }) => (
              <a
                href={href}
                class="text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
                title={name}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name={icon} class="w-6 h-6" />
              </a>
            ))}
          </div>

          <div class="flex justify-center items-center gap-1 text-sm mb-4">
            <a
              href={enUrl}
              class={`px-1 ${lang === 'en' ? 'text-primary font-bold' : 'text-gray-600 dark:text-gray-400'}`}
            >
              EN
            </a>
            <span class="text-gray-400">|</span>
            <a
              href={cyUrl}
              class={`px-1 ${lang === 'cy' ? 'text-primary font-bold' : 'text-gray-600 dark:text-gray-400'}`}
            >
              CY
            </a>
          </div>

          <div class="flex justify-center">
            <ToggleTheme iconClass="w-6 h-6" />
          </div>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const toggleMenu = document.querySelector('[data-toggle-menu]');
    const closeMenu = document.querySelector('[data-close-menu]');
    const mobileMenu = document.getElementById('mobile-menu');

    if (toggleMenu && mobileMenu && closeMenu) {
      const showMenu = () => {
        mobileMenu.classList.remove('translate-x-full');
        document.body.style.overflow = 'hidden';
      };

      const hideMenu = () => {
        mobileMenu.classList.add('translate-x-full');
        document.body.style.overflow = '';
      };

      toggleMenu.addEventListener('click', showMenu);
      closeMenu.addEventListener('click', hideMenu);

      // Handle window resize
      window.addEventListener('resize', () => {
        if (window.innerWidth >= 1280) {
          hideMenu();
        }
      });
    }
  });
</script>
