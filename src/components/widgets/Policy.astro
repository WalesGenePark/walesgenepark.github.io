---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import type { LanguageCode } from '~/i18n/routes';
import type { PrivacyEntry, CookiesEntry } from '~/types/content';

export interface Props {
  section: 'privacy' | 'cookies';
}

const { section } = Astro.props;
const currentLang = getLangFromUrl(Astro.url) as LanguageCode;
const t = useTranslations(currentLang);

// Get the content collection for the current section
const entries = await getCollection(section, ({ id }) => {
  return id.startsWith(`${currentLang}/`);
}) as (PrivacyEntry | CookiesEntry)[];

const entry = entries[0];
const { Content } = await entry.render();

const policyTitle = entry?.data.title || t(`nav.${section}`);
---

<section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
  <div class="mb-10 md:mx-auto text-center max-w-3xl">
    <h2 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
      {policyTitle}
    </h2>
    {entry?.data.description && <p class="text-xl text-gray-600 dark:text-slate-400">{entry.data.description}</p>}
  </div>

  <div class="prose prose-lg max-w-none dark:prose-invert">
    <Content />
  </div>
</section>
