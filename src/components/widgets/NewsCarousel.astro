---
import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import type { NewsEntry, EventEntry } from '~/types/content';
import { Icon } from 'astro-icon/components';

interface Props {
  items: (NewsEntry | EventEntry)[];
}

const { items } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const formatDate = (date: Date) => {
  return date.toLocaleDateString(lang === 'cy' ? 'cy' : 'en-GB', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

const getItemUrl = (item: NewsEntry | EventEntry) => {
  const collection = item.collection;
  const slug = item.slug.split('/').slice(1).join('/');
  return `/${lang}/${collection}/${slug}`;
};

const getTypeLabel = (type: 'news' | 'events') => {
  if (type === 'events') {
    return t('content.tag.event');
  }
  return t('content.tag.news');
};
---

<section class="px-4 pt-4 pb-16 mx-auto max-w-6xl lg:pb-20">
  <div class="carousel-container relative">
    <div class="carousel-track-container overflow-hidden">
      <div class="carousel-track flex transition-transform duration-500 ease-in-out">
        {
          items.map((item) => (
            <div class="carousel-slide w-full flex-shrink-0 px-4 md:w-1/3">
              <div class="h-full bg-white dark:bg-gray-800 shadow-lg rounded-lg overflow-hidden relative">
                <div class="absolute top-4 right-4 z-10">
                  <span
                    class={`px-3 py-1 text-xs font-semibold rounded-full ${
                      item.collection === 'events'
                        ? 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200'
                        : 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200'
                    }`}
                  >
                    {getTypeLabel(item.collection)}
                  </span>
                </div>
                {item.data.image ? (
                  <img src={item.data.image} alt="" class="w-full h-48 object-cover" loading="lazy" decoding="async" />
                ) : (
                  <div class="bg-gray-200 dark:bg-gray-700 w-full h-48" />
                )}
                <div class="p-6">
                  <div class="text-xs text-gray-500 mb-2">
                    {formatDate('publishDate' in item.data ? item.data.publishDate : item.data.date)}
                  </div>
                  <h3 class="text-xl font-bold leading-snug tracking-tight mb-2">
                    <a href={getItemUrl(item)} class="hover:text-primary transition ease-in duration-200">
                      {item.data.title}
                    </a>
                  </h3>
                  {item.data.description && (
                    <p class="text-gray-700 dark:text-gray-300 line-clamp-2">{item.data.description}</p>
                  )}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Desktop Navigation Buttons -->
    <button
      class="carousel-prev absolute -left-4 top-1/2 -translate-y-1/2 bg-white dark:bg-gray-800 rounded-full p-2 shadow-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-200 z-10 hidden md:block"
      aria-label="Previous slide"
      type="button"
    >
      <Icon name="tabler:chevron-left" class="w-6 h-6" />
    </button>
    <button
      class="carousel-next absolute -right-4 top-1/2 -translate-y-1/2 bg-white dark:bg-gray-800 rounded-full p-2 shadow-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-200 z-10 hidden md:block"
      aria-label="Next slide"
      type="button"
    >
      <Icon name="tabler:chevron-right" class="w-6 h-6" />
    </button>
    <!-- Navigation Controls Container -->
    <div class="mt-4">
      <!-- Mobile Navigation Arrows -->
      <div class="flex justify-center items-center gap-8 md:hidden">
        <button
          class="mobile-prev bg-white dark:bg-gray-800 rounded-full p-3 shadow-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-200"
          aria-label="Previous slide"
          type="button"
        >
          <Icon name="tabler:chevron-left" class="w-8 h-8" />
        </button>
        <button
          class="mobile-next bg-white dark:bg-gray-800 rounded-full p-3 shadow-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-200"
          aria-label="Next slide"
          type="button"
        >
          <Icon name="tabler:chevron-right" class="w-8 h-8" />
        </button>
      </div>
      <!-- Desktop Dots -->
      <div class="carousel-dots hidden md:flex justify-center gap-4">
        {
          Array.from({ length: Math.ceil(items.length / 3) }).map((_, index) => (
            <button
              class="carousel-dot w-11 h-11 rounded-full bg-gray-300 dark:bg-gray-600 transition-colors duration-200 hover:bg-gray-400 dark:hover:bg-gray-500"
              aria-label={`Go to slides ${index * 3 + 1} to ${Math.min((index + 1) * 3, items.length)}`}
            />
          ))
        }
      </div>
    </div>
  </div>
  <!-- End of carousel-container -->
</section>

<style>
  .carousel-track-container {
    margin: 0 1rem;
  }

  .carousel-track {
    transform: translateX(0);
  }

  /* Hide navigation buttons on mobile */
  @media (max-width: 768px) {
    .carousel-prev,
    .carousel-next {
      display: none;
    }
  }
</style>

<script is:inline>
  function setupCarousel() {
    const track = document.querySelector('.carousel-track');
    const prevBtn = document.querySelector('.carousel-prev');
    const nextBtn = document.querySelector('.carousel-next');
    const mobilePrevBtn = document.querySelector('.mobile-prev');
    const mobileNextBtn = document.querySelector('.mobile-next');
    const dots = document.querySelectorAll('.carousel-dot');
    const slidesPerGroup = 3;

    if (!track) return;

    let currentGroup = 0;
    let currentSlide = 0;
    const totalSlides = track.children.length;
    const groupCount = dots.length || Math.ceil(totalSlides / slidesPerGroup);
    let autoplayTimer = null;
    let touchStartX = 0;
    let touchEndX = 0;
    const SWIPE_THRESHOLD = 50;

    function updateSlide(index, isMobile = window.innerWidth < 768) {
      if (isMobile) {
        // Single slide navigation for mobile
        currentSlide = ((index % totalSlides) + totalSlides) % totalSlides;
        currentGroup = Math.floor(currentSlide / slidesPerGroup);
        const offset = currentSlide * 100;
        track.style.transform = `translateX(-${offset}%)`;
      } else {
        // Group navigation for desktop
        currentGroup = ((index % groupCount) + groupCount) % groupCount;
        currentSlide = currentGroup * slidesPerGroup;
        const slideWidth = 100 / 3;
        const offset = currentGroup * slidesPerGroup * slideWidth;
        track.style.transform = `translateX(-${offset}%)`;
      }

      // Update dots if they exist
      if (dots.length) {
        dots.forEach((dot) => {
          dot.classList.remove('bg-red-500', 'dark:bg-red-500');
          dot.classList.add('bg-gray-300', 'dark:bg-gray-600');
        });
        dots[currentGroup].classList.remove('bg-gray-300', 'dark:bg-gray-600');
        dots[currentGroup].classList.add('bg-red-500', 'dark:bg-red-500');
      }
    }

    function startAutoplay() {
      stopAutoplay();
      autoplayTimer = setInterval(() => {
        const isMobile = window.innerWidth < 768;
        if (isMobile) {
          updateSlide(currentSlide + 1, true);
        } else {
          updateSlide(currentGroup + 1, false);
        }
      }, 3000);
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    // Add click handlers for desktop navigation
    if (prevBtn && nextBtn) {
      prevBtn.onclick = () => {
        updateSlide(currentGroup - 1, false);
        stopAutoplay();
        startAutoplay();
      };

      nextBtn.onclick = () => {
        updateSlide(currentGroup + 1, false);
        stopAutoplay();
        startAutoplay();
      };
    }

    // Add click handlers for mobile navigation
    if (mobilePrevBtn && mobileNextBtn) {
      mobilePrevBtn.onclick = () => {
        updateSlide(currentSlide - 1, true);
        stopAutoplay();
        startAutoplay();
      };

      mobileNextBtn.onclick = () => {
        updateSlide(currentSlide + 1, true);
        stopAutoplay();
        startAutoplay();
      };
    }

    // Add click handlers for dots
    if (dots.length) {
      dots.forEach((dot, index) => {
        dot.onclick = () => {
          updateSlide(index, false);
          stopAutoplay();
          startAutoplay();
        };
      });
    }

    // Add touch handlers
    track.addEventListener('touchstart', handleTouchStart);
    track.addEventListener('touchmove', handleTouchMove);
    track.addEventListener('touchend', handleTouchEnd);

    function handleTouchStart(e) {
      touchStartX = e.touches[0].clientX;
    }

    function handleTouchMove(e) {
      touchEndX = e.touches[0].clientX;
    }

    function handleTouchEnd() {
      const swipeDistance = touchEndX - touchStartX;
      const isMobile = window.innerWidth < 768;

      if (Math.abs(swipeDistance) > SWIPE_THRESHOLD) {
        if (swipeDistance > 0) {
          // Swiped right - go to previous
          if (isMobile) {
            updateSlide(currentSlide - 1, true);
          } else {
            updateSlide(currentGroup - 1, false);
          }
        } else {
          // Swiped left - go to next
          if (isMobile) {
            updateSlide(currentSlide + 1, true);
          } else {
            updateSlide(currentGroup + 1, false);
          }
        }
      }

      // Reset touch coordinates
      touchStartX = 0;
      touchEndX = 0;
    }

    // Handle window resize
    window.addEventListener('resize', () => {
      const isMobile = window.innerWidth < 768;
      if (isMobile) {
        updateSlide(currentSlide, true);
      } else {
        updateSlide(currentGroup, false);
      }
    });

    // Start autoplay
    startAutoplay();
  }

  // Setup carousel when DOM is loaded
  document.addEventListener('DOMContentLoaded', setupCarousel);
</script>
