---
import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import type { NewsEntry, EventEntry } from '~/types/content';
import { Icon } from 'astro-icon/components';

interface Props {
  items: (NewsEntry | EventEntry)[];
}

const { items } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const formatDate = (date: Date) => {
  return date.toLocaleDateString(lang === 'cy' ? 'cy' : 'en-GB', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

const getItemUrl = (item: NewsEntry | EventEntry) => {
  const collection = item.collection;
  const slug = item.slug.split('/').slice(1).join('/');
  return `/${lang}/${collection}/${slug}`;
};

const getTypeLabel = (type: 'news' | 'events') => {
  if (type === 'events') {
    return t('content.tag.event');
  }
  return t('content.tag.news');
};
---

<section class="px-4 py-16 mx-auto max-w-6xl lg:py-20">
  <div class="carousel-container relative">
    <div class="carousel-track-container overflow-hidden">
      <div class="carousel-track flex transition-transform duration-500 ease-in-out">
        {
          items.map((item) => (
            <div class="carousel-slide w-full md:w-1/3 flex-shrink-0 px-4">
              <div class="h-full bg-white dark:bg-gray-800 shadow-lg rounded-lg overflow-hidden relative">
                <div class="absolute top-4 right-4 z-10">
                  <span
                    class={`px-3 py-1 text-xs font-semibold rounded-full ${
                      item.collection === 'events'
                        ? 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200'
                        : 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200'
                    }`}
                  >
                    {getTypeLabel(item.collection)}
                  </span>
                </div>
                {item.data.image ? (
                  <img src={item.data.image} alt="" class="w-full h-48 object-cover" loading="lazy" decoding="async" />
                ) : (
                  <div class="bg-gray-200 dark:bg-gray-700 w-full h-48" />
                )}
                <div class="p-6">
                  <div class="text-xs text-gray-500 mb-2">
                    {formatDate(
                      'publishDate' in item.data ? new Date(item.data.publishDate) : new Date(item.data.startDate)
                    )}
                  </div>
                  <h3 class="text-xl font-bold leading-snug tracking-tight mb-2">
                    <a href={getItemUrl(item)} class="hover:text-primary transition ease-in duration-200">
                      {item.data.title}
                    </a>
                  </h3>
                  {item.data.description && (
                    <p class="text-gray-700 dark:text-gray-300 line-clamp-2">{item.data.description}</p>
                  )}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Navigation Buttons -->
    <button
      class="carousel-prev absolute -left-4 top-1/2 -translate-y-1/2 bg-white dark:bg-gray-800 rounded-full p-2 shadow-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-200 z-10"
      aria-label="Previous slide"
      type="button"
    >
      <Icon name="tabler:chevron-left" class="w-6 h-6" />
    </button>
    <button
      class="carousel-next absolute -right-4 top-1/2 -translate-y-1/2 bg-white dark:bg-gray-800 rounded-full p-2 shadow-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-200 z-10"
      aria-label="Next slide"
      type="button"
    >
      <Icon name="tabler:chevron-right" class="w-6 h-6" />
    </button>

    <!-- Dots -->
    <div class="carousel-dots flex justify-center gap-2 mt-4">
      {
        items.map((_, index) => (
          <button
            class="carousel-dot w-3 h-3 rounded-full bg-gray-300 dark:bg-gray-600 transition-colors duration-200"
            aria-label={`Go to slide ${index + 1}`}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .carousel-track-container {
    margin: 0 1rem;
  }

  .carousel-track {
    transform: translateX(0);
  }
</style>

<script is:inline>
  function setupCarousel() {
    const track = document.querySelector('.carousel-track');
    const prevBtn = document.querySelector('.carousel-prev');
    const nextBtn = document.querySelector('.carousel-next');
    const dots = document.querySelectorAll('.carousel-dot');

    if (!track || !dots.length) return;

    let currentSlide = 0;
    const slideCount = dots.length;
    let autoplayTimer = null;
    let touchStartX = 0;
    let touchEndX = 0;
    const SWIPE_THRESHOLD = 50;

    function updateSlide(index) {
      // Ensure index is within bounds
      currentSlide = ((index % slideCount) + slideCount) % slideCount;

      // Move track
      track.style.transform = `translateX(-${currentSlide * (100 / 3)}%)`;

      // Reset all dots first
      dots.forEach((dot) => {
        dot.classList.remove('bg-red-600', 'dark:bg-red-500');
        dot.classList.add('bg-gray-300', 'dark:bg-gray-600');
      });

      // Then update current dot
      dots[currentSlide].classList.remove('bg-gray-300', 'dark:bg-gray-600');
      dots[currentSlide].classList.add('bg-red-600', 'dark:bg-red-500');
    }

    function startAutoplay() {
      stopAutoplay();
      autoplayTimer = setInterval(() => {
        updateSlide(currentSlide + 1);
      }, 3000);
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    function handleTouchStart(e) {
      touchStartX = e.touches[0].clientX;
    }

    function handleTouchMove(e) {
      touchEndX = e.touches[0].clientX;
    }

    function handleTouchEnd() {
      const swipeDistance = touchEndX - touchStartX;

      if (Math.abs(swipeDistance) > SWIPE_THRESHOLD) {
        if (swipeDistance > 0) {
          // Swiped right - go to previous slide
          updateSlide(currentSlide - 1);
        } else {
          // Swiped left - go to next slide
          updateSlide(currentSlide + 1);
        }
      }

      // Reset touch coordinates
      touchStartX = 0;
      touchEndX = 0;
    }

    // Add click handlers
    prevBtn.onclick = () => {
      updateSlide(currentSlide - 1);
      stopAutoplay();
      startAutoplay();
    };

    nextBtn.onclick = () => {
      updateSlide(currentSlide + 1);
      stopAutoplay();
      startAutoplay();
    };

    dots.forEach((dot, i) => {
      dot.onclick = () => {
        updateSlide(i);
        stopAutoplay();
        startAutoplay();
      };
    });

    // Add touch handlers
    track.addEventListener('touchstart', handleTouchStart, { passive: true });
    track.addEventListener('touchmove', handleTouchMove, { passive: true });
    track.addEventListener('touchend', handleTouchEnd);

    // Start autoplay
    startAutoplay();

    // Pause autoplay when user interacts with the carousel
    track.addEventListener('mouseenter', stopAutoplay);
    track.addEventListener('mouseleave', startAutoplay);
    track.addEventListener('touchstart', stopAutoplay);
    track.addEventListener('touchend', startAutoplay);

    // Initialize with first slide
    updateSlide(0);
  }

  // Run on page load
  document.addEventListener('DOMContentLoaded', setupCarousel);

  // Run after Astro view transitions
  document.addEventListener('astro:page-load', setupCarousel);
  document.addEventListener('astro:after-swap', setupCarousel);
</script>
