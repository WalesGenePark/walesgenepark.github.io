---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

const allNews = await getCollection('news');
const allEvents = await getCollection('events');

// Combine news and events into a single array
const combinedItems = [
  ...allNews.map(item => ({
    ...item,
    type: 'news',
    date: item.data.date,
    readMoreLink: item.data.readMoreLink || `/news/${item.slug}`
  })),
  ...allEvents.map(item => ({
    ...item,
    type: 'event',
    date: item.data.startDate,
    readMoreLink: item.data.readMoreLink || `/events/${item.slug}`
  }))
];

// Sort combined items by date
const sortedItems = combinedItems
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 15);

interface Props {
  id?: string;
  classes?: Record<string, string>;
}

const { id, classes = {} } = Astro.props;
---

<div id={id ?? 'news-carousel'} class="relative py-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">Latest News & Events</h2>
        <p class="text-gray-600 dark:text-gray-300 mb-4">Stay updated with our latest announcements, research, and upcoming events.</p>
        <a href="/news" class="inline-flex items-center text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300">
          Read all <Icon name="tabler:arrow-right" class="w-4 h-4 ml-1" />
        </a>
      </div>

      <div class="overflow-hidden px-12"> 
        <div class="flex transition-transform duration-500 ease-in-out" id="carousel-container">
          {
            sortedItems.map((item, index) => (
              <div class="w-full flex-shrink-0 px-4 py-2 md:w-1/3" data-index={index}>
                <article class="bg-white dark:bg-slate-900 rounded-xl overflow-hidden shadow-lg h-full flex flex-col">
                  {item.data.image && (
                    <div class="relative h-48">
                      <img
                        src={item.data.image}
                        alt={item.data.title}
                        class="w-full h-full object-cover"
                      />
                    </div>
                  )}
                  <div class="p-5 flex-grow flex flex-col">
                    <div class="flex items-center justify-between mb-2">
                      <span class="text-sm font-medium text-red-600 dark:text-red-400">
                        {item.type === 'event' ? (
                          <>
                            <Icon name="tabler:calendar-event" class="inline-block w-4 h-4 mr-1" />
                            {item.date.toLocaleDateString('en-GB', {
                              day: 'numeric',
                              month: 'long',
                              year: 'numeric',
                            })}
                          </>
                        ) : (
                          <>
                            <Icon name="tabler:news" class="inline-block w-4 h-4 mr-1" />
                            {item.date.toLocaleDateString('en-GB', {
                              day: 'numeric',
                              month: 'long',
                              year: 'numeric',
                            })}
                          </>
                        )}
                      </span>
                      <span class={`text-sm font-medium px-2 py-1 rounded-full ${
                        item.type === 'event' 
                          ? 'bg-red-100 text-red-800 dark:bg-red-900/20 dark:text-red-400'
                          : 'bg-blue-100 text-blue-800 dark:bg-blue-900/20 dark:text-blue-400'
                      }`}>
                        {item.type === 'event' ? 'Event' : 'News'}
                      </span>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3 line-clamp-2">
                      {item.data.title}
                    </h3>
                    <p class="text-gray-600 dark:text-gray-300 mb-4 line-clamp-3">
                      {item.data.description}
                    </p>
                    <div class="mt-auto">
                      <a
                        href={item.type === 'event' ? `/events/${item.slug}` : `/news/${item.slug}`}
                        class="inline-flex items-center text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300"
                      >
                        Read more
                        <Icon name="tabler:arrow-right" class="w-4 h-4 ml-1" />
                      </a>
                    </div>
                  </div>
                </article>
              </div>
            ))
          }
        </div>
      </div>

      <button
        class="absolute left-0 top-1/2 transform -translate-y-1/2 bg-white dark:bg-slate-900 p-2 rounded-full shadow-lg hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none"
        id="prev-button"
        aria-label="Previous slide"
      >
        <Icon name="tabler:chevron-left" class="w-6 h-6 text-gray-900 dark:text-white" />
      </button>

      <button
        class="absolute right-0 top-1/2 transform -translate-y-1/2 bg-white dark:bg-slate-900 p-2 rounded-full shadow-lg hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none"
        id="next-button"
        aria-label="Next slide"
      >
        <Icon name="tabler:chevron-right" class="w-6 h-6 text-gray-900 dark:text-white" />
      </button>
    </div>

    <div class="flex justify-center mt-8" id="carousel-dots">
      {sortedItems.map((_, index) => (
        <button
          class="w-3 h-3 mx-1 rounded-full bg-gray-300 dark:bg-gray-600 focus:outline-none"
          data-index={index}
          aria-label={`Go to slide ${index + 1}`}
        />
      ))}
    </div>
  </div>
</div>

<script>
  let currentSlide = 0;
  let container = document.getElementById('carousel-container');
  let slides = document.querySelectorAll('[data-index]');
  let dots = document.querySelectorAll('#carousel-dots button');
  let totalSlides = slides.length;
  let slideWidth = 100 / 3; // Show 3 slides at a time
  let autoAdvanceInterval = null;

  function updateCarousel() {
    if (container) {
      container.style.transform = `translateX(-${currentSlide * slideWidth}%)`;
    }
    
    dots.forEach((dot, index) => {
      dot.classList.toggle('bg-red-600', index === currentSlide);
      dot.classList.toggle('bg-gray-300', index !== currentSlide);
    });
  }

  function nextSlide() {
    currentSlide = (currentSlide + 1) % (totalSlides - 2);
    updateCarousel();
  }

  function prevSlide() {
    currentSlide = (currentSlide - 1 + (totalSlides - 2)) % (totalSlides - 2);
    updateCarousel();
  }

  function initializeCarousel() {
    // Reset variables
    container = document.getElementById('carousel-container');
    slides = document.querySelectorAll('[data-index]');
    dots = document.querySelectorAll('#carousel-dots button');
    totalSlides = slides.length;
    currentSlide = 0;

    // Clear existing interval
    if (autoAdvanceInterval) {
      clearInterval(autoAdvanceInterval);
    }

    // Add event listeners
    const nextButton = document.getElementById('next-button');
    const prevButton = document.getElementById('prev-button');

    if (nextButton) {
      nextButton.onclick = (e) => {
        e.preventDefault();
        nextSlide();
      };
    }

    if (prevButton) {
      prevButton.onclick = (e) => {
        e.preventDefault();
        prevSlide();
      };
    }

    dots.forEach((dot, index) => {
      dot.onclick = (e) => {
        e.preventDefault();
        currentSlide = index;
        updateCarousel();
      };
    });

    // Start auto-advance
    autoAdvanceInterval = setInterval(nextSlide, 5000);

    // Initial state
    updateCarousel();
  }

  // Initialize on page load
  window.addEventListener('load', initializeCarousel);

  // Initialize when content changes
  const observer = new MutationObserver((mutations) => {
    for (const mutation of mutations) {
      if (mutation.type === 'childList' || mutation.type === 'attributes') {
        initializeCarousel();
        break;
      }
    }
  });

  // Start observing the document with the configured parameters
  observer.observe(document.body, {
    childList: true,
    subtree: true,
    attributes: true,
    attributeFilter: ['class', 'style']
  });

  // Re-initialize on visibility change
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') {
      initializeCarousel();
    }
  });

  // Re-initialize on route change
  document.addEventListener('astro:page-load', initializeCarousel);
  document.addEventListener('astro:after-swap', initializeCarousel);
</script>
