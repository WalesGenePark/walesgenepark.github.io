---
// Previous imports and interface remain the same
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';

interface Props {
  items: any[];
}

const { items } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Previous helper functions remain the same
const formatDate = (date: string | Date) => {
  const d = typeof date === 'string' ? new Date(date) : date;
  return d.toLocaleDateString(lang === 'cy' ? 'cy-GB' : 'en-GB', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

const getItemUrl = (item: any) => {
  const collection = item.collection;
  const baseUrl = `/${lang}/${collection === 'events' ? 'events' : 'news'}`;
  return `${baseUrl}/${item.slug.split('/').slice(1).join('/')}`;
};

const getTypeLabel = (collection: string) => {
  if (collection === 'events') {
    return lang === 'cy' ? 'Digwyddiad' : 'Event';
  }
  return lang === 'cy' ? 'Newyddion' : 'News';
};

// Calculate number of dots needed
const slidesPerView = 3;
const numDots = Math.max(1, items.length - slidesPerView + 1);
---

<!-- Previous section and title HTML remains the same -->
<section class="px-4 py-16 mx-auto max-w-6xl lg:py-20">
  <div class="flex flex-col items-center mb-8 text-center">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl sm:leading-none mb-4">
      {lang === 'cy' ? 'Newyddion a Digwyddiadau Diweddaraf' : 'Latest News and Events'}
    </h2>
    <div class="flex flex-col sm:flex-row gap-6 text-lg">
      <a
        href={`/${lang}/news`}
        class="text-primary hover:text-primary-dark dark:text-blue-400 dark:hover:text-blue-300 inline-flex items-center"
      >
        {lang === 'cy' ? 'Darllen yr holl newyddion' : 'Read all news'}
        <Icon name="tabler:chevron-right" class="w-5 h-5 ml-1" />
      </a>
      <a
        href={`/${lang}/events`}
        class="text-primary hover:text-primary-dark dark:text-blue-400 dark:hover:text-blue-300 inline-flex items-center"
      >
        {lang === 'cy' ? 'Gweld yr holl ddigwyddiadau' : 'View all events'}
        <Icon name="tabler:chevron-right" class="w-5 h-5 ml-1" />
      </a>
    </div>
  </div>

  <div class="relative" id="carousel">
    <!-- Navigation Arrows -->
    <div class="absolute inset-y-0 left-0 md:-left-12 flex items-center">
      <button
        class="carousel-prev bg-white dark:bg-slate-900 shadow-lg rounded-full p-3 hover:bg-gray-50 dark:hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-primary"
        aria-label="Previous"
      >
        <Icon name="tabler:chevron-left" class="w-6 h-6" />
      </button>
    </div>

    <div class="absolute inset-y-0 right-0 md:-right-12 flex items-center">
      <button
        class="carousel-next bg-white dark:bg-slate-900 shadow-lg rounded-full p-3 hover:bg-gray-50 dark:hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-primary"
        aria-label="Next"
      >
        <Icon name="tabler:chevron-right" class="w-6 h-6" />
      </button>
    </div>

    <!-- Carousel Container -->
    <div class="overflow-hidden px-1">
      <div class="carousel-track flex transition-transform duration-300" data-carousel-track>
        {items.map((item, index) => (
          <div class="carousel-item flex-none w-full md:w-1/3 px-3" data-index={index}>
            <div class="relative flex flex-col h-full bg-white dark:bg-slate-900 rounded-lg shadow-lg overflow-hidden">
              <div class="absolute top-4 right-4 z-10">
                <span class={`px-3 py-1 text-xs font-semibold rounded-full ${item.collection === 'events' ? 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200' : 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200'}`}>
                  {getTypeLabel(item.collection)}
                </span>
              </div>
              {item.data.image ? (
                <img
                  src={item.data.image}
                  alt={item.data.title}
                  class="object-cover w-full h-48"
                />
              ) : (
                <div class="bg-gray-200 dark:bg-gray-700 w-full h-48" />
              )}
              <div class="p-6">
                <div class="text-xs text-gray-500 mb-2">
                  {formatDate(item.data.publishDate || item.data.date)}
                </div>
                <h3 class="text-xl font-bold leading-snug tracking-tight mb-2">
                  <a
                    href={getItemUrl(item)}
                    class="hover:text-primary transition ease-in duration-200"
                  >
                    {item.data.title}
                  </a>
                </h3>
                {item.data.description && (
                  <p class="text-gray-600 dark:text-gray-400 line-clamp-2">
                    {item.data.description}
                  </p>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Dots -->
    <div class="flex justify-center mt-6 gap-2">
      {Array.from({ length: numDots }).map((_, index) => (
        <button
          class="carousel-dot w-2.5 h-2.5 rounded-full bg-gray-300 dark:bg-gray-700 transition-colors duration-200 hover:bg-primary dark:hover:bg-primary"
          data-index={index}
          aria-label={`Go to slide ${index + 1}`}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .carousel-dot.active {
    @apply bg-primary;
  }

  @media (max-width: 768px) {
    .carousel-item {
      flex: 0 0 100%;
    }
  }

  @media (min-width: 769px) {
    .carousel-item {
      flex: 0 0 33.333%;
    }
  }
</style>

<script>
function initializeCarousel() {
  const carousels = document.querySelectorAll('#carousel');
  carousels.forEach(carousel => {
    const track = carousel.querySelector('[data-carousel-track]') as HTMLElement;
    const items = carousel.querySelectorAll('.carousel-item');
    const dots = carousel.querySelectorAll('.carousel-dot');
    const prevButton = carousel.querySelector('.carousel-prev');
    const nextButton = carousel.querySelector('.carousel-next');

    if (!track || !items.length || !dots.length || !prevButton || !nextButton) return;

    let currentIndex = 0;
    const totalSlides = items.length;
    const slidesPerView = window.innerWidth >= 768 ? 3 : 1;
    const maxIndex = Math.max(0, totalSlides - slidesPerView);

    const updateDots = (index: number) => {
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === index);
      });
    };

    const updateSlidePosition = (index: number) => {
      const slideWidth = 100 / slidesPerView;
      track.style.transform = `translateX(-${index * slideWidth}%)`;
      updateDots(index);

      // Update button states
      prevButton.disabled = index === 0;
      nextButton.disabled = index === maxIndex;
      prevButton.style.opacity = index === 0 ? '0.5' : '1';
      nextButton.style.opacity = index === maxIndex ? '0.5' : '1';
    };

    const goToSlide = (index: number) => {
      currentIndex = Math.max(0, Math.min(index, maxIndex));
      updateSlidePosition(currentIndex);
    };

    prevButton.addEventListener('click', () => {
      if (currentIndex > 0) {
        goToSlide(currentIndex - 1);
      }
    });

    nextButton.addEventListener('click', () => {
      if (currentIndex < maxIndex) {
        goToSlide(currentIndex + 1);
      }
    });

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        goToSlide(index);
      });
    });

    // Handle window resize
    let resizeTimeout: number;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = window.setTimeout(() => {
        const newSlidesPerView = window.innerWidth >= 768 ? 3 : 1;
        if (newSlidesPerView !== slidesPerView) {
          goToSlide(0);
        }
      }, 100);
    });

    // Initialize first slide
    updateSlidePosition(0);
  });
}

// Initialize on page load
document.addEventListener('astro:page-load', initializeCarousel);
</script>
