---
import { Icon } from 'astro-icon/components';

interface Props {
  events: any[];
  lang: string;
  month: number;
  year: number;
}

const { events, lang, month, year } = Astro.props;

// Filter events for current month and year
const monthEvents = events.filter(event => {
  const date = new Date(event.data.date);
  return date.getMonth() === month && date.getFullYear() === year;
}).sort((a, b) => {
  const dateA = new Date(a.data.date);
  const dateB = new Date(b.data.date);
  if (dateA.getTime() === dateB.getTime()) {
    const timeA = a.data.startTime || '';
    const timeB = b.data.startTime || '';
    return timeA.localeCompare(timeB);
  }
  return dateA.getTime() - dateB.getTime();
});

// Group events by date
const eventsByDate = monthEvents.reduce((acc, event) => {
  const date = new Date(event.data.date);
  const dateStr = date.toISOString().split('T')[0];
  if (!acc[dateStr]) acc[dateStr] = [];
  acc[dateStr].push(event);
  return acc;
}, {} as Record<string, typeof events>);

const today = new Date();
const isPastDay = (date: Date) => {
  return date < new Date(today.getFullYear(), today.getMonth(), today.getDate());
};
---

<div class="calendar-list bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden">
  <div class="divide-y divide-gray-200 dark:divide-gray-700">
    {Object.entries(eventsByDate).map(([dateStr, dayEvents]) => {
      const date = new Date(dateStr);
      const isPast = isPastDay(date);

      return (
        <div class={`p-6 ${isPast ? 'bg-gray-50 dark:bg-gray-900' : ''}`}>
          <div class="flex items-start">
            <div class={`flex-shrink-0 w-20 text-center bg-gray-100 dark:bg-gray-800 rounded-lg p-2`}>
              <div class={`text-3xl font-bold ${isPast ? 'text-gray-400 dark:text-gray-600' : ''}`}>
                {date.getDate()}
              </div>
              <div class={`text-sm font-medium ${isPast ? 'text-gray-400 dark:text-gray-600' : 'text-gray-600 dark:text-gray-400'}`}>
                {date.toLocaleDateString(lang === 'cy' ? 'cy-GB' : 'en-GB', { weekday: 'short' })}
              </div>
            </div>
            <div class="ml-6 flex-grow space-y-4">
              {dayEvents.map((event) => {
                const startTime = event.data.startTime || '';
                const endTime = event.data.endTime || '';
                const timeDisplay = startTime && endTime ? `${startTime} - ${endTime}` : startTime || '';

                return (
                  <div class={`event-item ${isPast ? 'opacity-50' : ''}`}>
                    <a
                      href={`/${lang}/calendar/${event.slug.split('/')[1]}`}
                      class="block hover:bg-gray-50 dark:hover:bg-gray-800 rounded-lg p-2 -ml-2 group"
                    >
                      {timeDisplay && (
                        <div class="text-sm text-primary font-medium mb-1">{timeDisplay}</div>
                      )}
                      <div class="text-base font-medium text-gray-900 dark:text-gray-100 group-hover:text-primary">
                        {event.data.title}
                      </div>
                      {event.data.location && (
                        <div class="flex items-center text-gray-600 dark:text-gray-400 mt-1">
                          <Icon name="tabler:map-pin" class="w-4 h-4 mr-2" />
                          <span class="text-sm">{event.data.location}</span>
                        </div>
                      )}
                    </a>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      );
    })}

    {monthEvents.length === 0 && (
      <div class="p-6 text-center text-gray-500 dark:text-gray-400">
        No events scheduled for this month.
      </div>
    )}
  </div>
</div>

<style>
.calendar-list {
  @apply w-full;
}

.event-item:hover {
  @apply transform transition-transform duration-100 scale-[1.01];
}
</style>
