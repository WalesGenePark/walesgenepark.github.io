---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import type { TeamEntry } from '~/types/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const team = (await getCollection('team', (entry) => entry.data.lang === lang)) as TeamEntry[];

// Sort team by order
const sortedTeam = team.sort((a, b) => {
  return (a.data.order || 999) - (b.data.order || 999);
});
---

<section class="px-4 mx-auto max-w-6xl">
  <header class="py-16 lg:py-20">
    <h2 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading text-red-500 dark:text-red-500 text-center">
      {t('nav.team')}
    </h2>
  </header>

  <div class="grid gap-8 row-gap-8 md:grid-cols-2 lg:grid-cols-3 pb-16 lg:pb-20">
    {
      sortedTeam.map((member) => (
        <article class="flex flex-col items-center text-center mb-6 transition">
          <div class="relative w-48 h-48 mb-6 overflow-hidden rounded-full border-4 border-primary-100 dark:border-primary-900">
            {member.data.image && (
              <img
                src={member.data.image}
                class="w-full h-full object-cover"
                alt={member.data.name}
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
          <h3 class="mb-2 text-xl font-bold leading-snug font-heading">{member.data.name}</h3>
          {member.data.title && (
            <p class="text-primary-600 dark:text-primary-400 font-medium mb-1">{member.data.title}</p>
          )}
          {member.data.department && <p class="text-gray-600 dark:text-gray-400 mb-3">{member.data.department}</p>}
          {member.data.bio && <p class="text-gray-600 dark:text-gray-400 mb-4 px-4">{member.data.bio}</p>}
          <div class="flex gap-3 mt-auto">
            {member.data.email && (
              <a
                href={`mailto:${member.data.email}`}
                class="text-gray-500 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400"
                title="Email"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <polyline points="3 7 12 13 21 7" />
                </svg>
              </a>
            )}
            {member.data.socialLinks?.linkedin && (
              <a
                href={member.data.socialLinks.linkedin}
                class="text-gray-500 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400"
                title="LinkedIn"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <rect x="4" y="4" width="16" height="16" rx="2" />
                  <line x1="8" y1="11" x2="8" y2="16" />
                  <line x1="8" y1="8" x2="8" y2="8.01" />
                  <line x1="12" y1="16" x2="12" y2="11" />
                  <path d="M16 16v-3a2 2 0 0 0 -4 0" />
                </svg>
              </a>
            )}
            {member.data.socialLinks?.twitter && (
              <a
                href={member.data.socialLinks.twitter}
                class="text-gray-500 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400"
                title="Twitter"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M22 4.01c-1 .49 -1.98 .689 -3 .99c-1.121 -1.265 -2.783 -1.335 -4.38 -.737s-2.643 2.06 -2.62 3.737v1c-3.245 .083 -6.135 -1.395 -8 -4c0 0 -4.182 7.433 4 11c-1.872 1.247 -3.739 2.088 -6 2c3.308 1.803 6.913 2.423 10.034 1.517c3.58 -1.04 6.522 -3.723 7.651 -7.742a13.84 13.84 0 0 0 .497 -3.753c-.002 -.249 1.51 -2.772 1.818 -4.013z" />
                </svg>
              </a>
            )}
            {member.data.socialLinks?.researchgate && (
              <a
                href={member.data.socialLinks.researchgate}
                class="text-gray-500 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400"
                title="ResearchGate"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M12 10v.01" />
                  <path d="M3 19l18 -14" />
                  <path d="M15 5l-3 5.5l3 5.5" />
                  <path d="M9 5l3 5.5l-3 5.5" />
                </svg>
              </a>
            )}
            {member.data.socialLinks?.orcid && (
              <a
                href={member.data.socialLinks.orcid}
                class="text-gray-500 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400"
                title="ORCID"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M7 12h3v4h-3z" />
                  <path d="M10.5 6h-6.5v12h6.5" />
                  <path d="M16 21h3v-4h-3z" />
                  <path d="M19.5 17h-6.5v-12h6.5" />
                </svg>
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
