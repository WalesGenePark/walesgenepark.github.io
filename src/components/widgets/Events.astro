---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import type { LanguageCode } from '~/i18n/routes';

const currentLang = getLangFromUrl(Astro.url) as LanguageCode;
const t = useTranslations(currentLang);

// Get all events
const events = await getCollection('events', ({ id }) => {
  return id.startsWith(currentLang + '/');
});

// Get today's date without time
const today = new Date();
today.setHours(0, 0, 0, 0);

// Split and sort events
const upcomingEvents = events
  .filter((event) => {
    const eventDate = new Date(event.data.date);
    eventDate.setHours(0, 0, 0, 0);
    return eventDate >= today;
  })
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());

const pastEvents = events
  .filter((event) => {
    const eventDate = new Date(event.data.date);
    eventDate.setHours(0, 0, 0, 0);
    return eventDate < today;
  })
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const formatEventDate = (date: Date) => {
  return {
    day: date.getDate(),
    month: date.toLocaleString(currentLang === 'cy' ? 'cy' : 'en-GB', { month: 'short' }).toUpperCase(),
    year: date.getFullYear(),
  };
};

const formatTime = (time: string) => {
  const [hours, minutes] = time.split(':');
  const date = new Date();
  date.setHours(parseInt(hours), parseInt(minutes));
  return date.toLocaleTimeString(currentLang === 'cy' ? 'cy' : 'en-GB', {
    hour: 'numeric',
    minute: '2-digit',
    hour12: true,
  });
};
---

<section class="px-4 py-16 mx-auto max-w-4xl lg:py-20">
  {/* Upcoming Events */}
  <header class="pb-8 lg:pb-12">
    <h2
      class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-8 font-heading text-red-500 dark:text-red-500 text-center"
    >
      {t('events.upcomingEvents')}
    </h2>

    {/* Search Input */}
    <div class="mb-4">
      <div class="relative">
        <input
          type="text"
          id="eventSearch"
          placeholder={t('events.searchPlaceholder')}
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-800 dark:border-gray-600 dark:text-white text-gray-900 dark:text-gray-100 placeholder:text-gray-600 dark:placeholder:text-gray-300"
        />
        <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
          <svg class="w-5 h-5 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
      </div>
    </div>

    {/* No Results Message */}
    <p id="upcomingNoResults" class="hidden text-center text-gray-600 dark:text-gray-400 text-lg mb-8">
      {t('events.noSearchResults')}
    </p>
  </header>

  <div id="upcomingEventsList">
    {
      upcomingEvents.length === 0 ? (
        <p class="text-gray-600 dark:text-gray-400">{t('events.noUpcomingEvents')}</p>
      ) : (
        <ul class="space-y-8">
          {upcomingEvents.map((event) => (
            <li
              class="flex gap-6 items-start pl-4 border border-gray-200 dark:border-gray-700 rounded-lg p-6 hover:shadow-lg hover:border-primary-300 dark:hover:border-primary-700 transition-all duration-300 ease-in-out"
              data-title={event.data.title.toLowerCase()}
              data-description={event.data.description?.toLowerCase()}
              data-location={event.data.location?.toLowerCase()}
            >
              <div class="flex-shrink-0 w-24 text-center">
                <div class="text-3xl font-bold text-red-500 dark:text-red-500">
                  {formatEventDate(new Date(event.data.date)).day}
                </div>
                <div class="text-gray-600 dark:text-gray-400 uppercase text-sm">
                  {formatEventDate(new Date(event.data.date)).month}
                </div>
                <div class="text-gray-600 dark:text-gray-400 text-sm">
                  {formatEventDate(new Date(event.data.date)).year}
                </div>
              </div>
              <div class="flex-grow">
                <h3 class="mb-2 text-xl font-bold leading-snug font-heading">
                  <a
                    href={`/${currentLang}/events/${event.slug.split('/').slice(1).join('/')}`}
                    class="hover:text-primary-600 underline underline-offset-4 decoration-1 decoration-dotted transition ease-in duration-200"
                  >
                    {event.data.title}
                  </a>
                </h3>
                {event.data.description && (
                  <p class="text-gray-700 dark:text-gray-300 line-clamp-2">{event.data.description}</p>
                )}
                <div class="mt-2 text-sm text-gray-600 dark:text-gray-400">
                  {event.data.startTime && (
                    <span>
                      {t('events.time')}: {formatTime(event.data.startTime)}
                      {event.data.endTime && ` - ${formatTime(event.data.endTime)}`}
                    </span>
                  )}
                  {event.data.location && (
                    <span class="ml-4">
                      {t('events.location')}: {event.data.location}
                    </span>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  {/* Past Events */}
  {
    pastEvents.length > 0 && (
      <div class="border-t border-gray-200 dark:border-gray-700 pt-10">
        <div class="flex flex-col items-center mb-8">
          <h2 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading text-red-500 dark:text-red-500 text-center w-full">
            {t('events.pastEvents')}
          </h2>
          <button
            id="togglePastEvents"
            class="text-sm font-medium text-primary-600 hover:text-primary-800 dark:hover:text-primary-400 transition duration-150 ease-in-out mt-4"
            aria-expanded="false"
            data-show-text={t('events.showPastEvents')}
            data-hide-text={t('events.hidePastEvents')}
          >
            {t('events.showPastEvents')}
          </button>
        </div>

        {/* Past Events No Results Message */}
        <p id="pastNoResults" class="hidden text-center text-gray-600 dark:text-gray-400 text-lg mb-8">
          {t('events.noSearchResults')}
        </p>

        <div id="pastEventsList" class="hidden">
          <ul class="space-y-8">
            {pastEvents.map((event) => (
              <li
                class="flex gap-6 items-start pl-4 border border-gray-200 dark:border-gray-700 rounded-lg p-6 hover:shadow-lg hover:border-primary-300 dark:hover:border-primary-700 transition-all duration-300 ease-in-out opacity-75"
                data-title={event.data.title.toLowerCase()}
                data-description={event.data.description?.toLowerCase()}
                data-location={event.data.location?.toLowerCase()}
              >
                <div class="flex-shrink-0 w-24 text-center">
                  <div class="text-3xl font-bold text-red-500 dark:text-red-500">
                    {formatEventDate(new Date(event.data.date)).day}
                  </div>
                  <div class="text-gray-500 dark:text-gray-500 uppercase text-sm">
                    {formatEventDate(new Date(event.data.date)).month}
                  </div>
                  <div class="text-gray-500 dark:text-gray-500 text-sm">
                    {formatEventDate(new Date(event.data.date)).year}
                  </div>
                </div>
                <div class="flex-grow">
                  <h3 class="mb-2 text-xl font-bold leading-snug font-heading text-gray-600 dark:text-gray-400">
                    <a
                      href={`/${currentLang}/events/${event.slug.split('/').slice(1).join('/')}`}
                      class="hover:text-primary-600 underline underline-offset-4 decoration-1 decoration-dotted transition ease-in duration-200"
                    >
                      {event.data.title}
                    </a>
                  </h3>
                  {event.data.description && (
                    <p class="text-gray-500 dark:text-gray-500 line-clamp-2">{event.data.description}</p>
                  )}
                  <div class="mt-2 text-sm text-gray-600 dark:text-gray-400">
                    {event.data.startTime && (
                      <span>
                        {t('events.time')}: {formatTime(event.data.startTime)}
                        {event.data.endTime && ` - ${formatTime(event.data.endTime)}`}
                      </span>
                    )}
                    {event.data.location && (
                      <span class="ml-4">
                        {t('events.location')}: {event.data.location}
                      </span>
                    )}
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    )
  }
</section>

<script>
  function initializeEvents() {
    const toggleButton = document.getElementById('togglePastEvents');
    const pastEventsList = document.getElementById('pastEventsList');
    const searchInput = document.getElementById('eventSearch') as HTMLInputElement;
    const upcomingNoResults = document.getElementById('upcomingNoResults');
    const pastNoResults = document.getElementById('pastNoResults');

    function filterEvents(searchTerm: string) {
      const normalizedSearch = searchTerm.toLowerCase();
      let upcomingVisible = false;
      let pastVisible = false;

      // Filter upcoming events
      document.querySelectorAll('#upcomingEventsList li').forEach((event) => {
        const element = event as HTMLElement;
        const title = element.dataset.title || '';
        const description = element.dataset.description || '';
        const location = element.dataset.location || '';
        const matches =
          title.includes(normalizedSearch) ||
          description.includes(normalizedSearch) ||
          location.includes(normalizedSearch);
        element.style.display = matches ? '' : 'none';
        if (matches) upcomingVisible = true;
      });

      // Filter past events if they're visible
      if (pastEventsList && !pastEventsList.classList.contains('hidden')) {
        document.querySelectorAll('#pastEventsList li').forEach((event) => {
          const element = event as HTMLElement;
          const title = element.dataset.title || '';
          const description = element.dataset.description || '';
          const location = element.dataset.location || '';
          const matches =
            title.includes(normalizedSearch) ||
            description.includes(normalizedSearch) ||
            location.includes(normalizedSearch);
          element.style.display = matches ? '' : 'none';
          if (matches) pastVisible = true;
        });
      }

      // Show/hide no results messages
      if (upcomingNoResults) {
        upcomingNoResults.style.display = !upcomingVisible && searchTerm ? 'block' : 'none';
      }
      if (pastNoResults) {
        pastNoResults.style.display =
          !pastVisible && searchTerm && !pastEventsList?.classList.contains('hidden') ? 'block' : 'none';
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        filterEvents(target.value);
      });
    }

    if (toggleButton && pastEventsList) {
      const showText = toggleButton.dataset.showText || 'Show Past Events';
      const hideText = toggleButton.dataset.hideText || 'Hide Past Events';
      const isExpanded = toggleButton.getAttribute('aria-expanded') === 'true';

      // Set initial state
      pastEventsList.classList.toggle('hidden', !isExpanded);
      toggleButton.textContent = isExpanded ? hideText : showText;

      toggleButton.addEventListener('click', () => {
        const newExpanded = !pastEventsList.classList.contains('hidden');
        pastEventsList.classList.toggle('hidden');
        toggleButton.setAttribute('aria-expanded', (!newExpanded).toString());
        toggleButton.textContent = newExpanded ? showText : hideText;

        // Reapply search filter when showing past events
        if (!newExpanded && searchInput) {
          filterEvents(searchInput.value);
        }
      });
    }
  }

  // Initialize on first load
  initializeEvents();

  // Re-initialize on view transitions
  document.addEventListener('astro:page-load', initializeEvents);
  document.addEventListener('astro:after-swap', initializeEvents);
</script>
