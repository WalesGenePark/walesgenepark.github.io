---
import { SITE } from 'astrowind:config';
import { getLangFromUrl } from '~/i18n/utils';

const lang = getLangFromUrl(Astro.url);

// Privacy and cookie policy links
const policyLinks = {
  en: {
    privacy: { text: 'Privacy Policy', href: '/en/privacy' },
    cookies: { text: 'Cookie Policy', href: '/en/cookies' },
  },
  cy: {
    privacy: { text: 'Polisi Preifatrwydd', href: '/cy/privacy' },
    cookies: { text: 'Polisi Cwcis', href: '/cy/cookies' },
  },
};

// Placeholder partner logos
const partners = [
  { name: 'Partner 1', logo: '/images/placeholder-logo.png' },
  { name: 'Partner 2', logo: '/images/placeholder-logo.png' },
  { name: 'Partner 3', logo: '/images/placeholder-logo.png' },
  { name: 'Partner 4', logo: '/images/placeholder-logo.png' },
  { name: 'Partner 5', logo: '/images/placeholder-logo.png' },
  { name: 'Partner 6', logo: '/images/placeholder-logo.png' },
];
---

<footer class="relative bg-white dark:bg-slate-900 not-prose">
  <!-- Red divider -->
  <div class="h-0.5 w-full bg-red-600"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 space-y-4">
    <!-- Site Name -->
    <div class="text-center">
      <a class="inline-block font-bold text-xl text-gray-900 dark:text-white" href={`/${lang}`}>
        {SITE?.name}
      </a>
    </div>

    <!-- Policy Links -->
    <div class="flex justify-center space-x-4">
      <a
        href={policyLinks[lang].privacy.href}
        class="text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300"
      >
        {policyLinks[lang].privacy.text}
      </a>
      <span class="text-gray-300 dark:text-gray-600">|</span>
      <a
        href={policyLinks[lang].cookies.href}
        class="text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300"
      >
        {policyLinks[lang].cookies.text}
      </a>
    </div>

    <!-- Partner Logos Grid -->
    <div class="grid grid-cols-8 gap-1 items-center">
      {/* Empty first column */}
      <div class="w-full"></div>

      {/* 6 partner logos */}
      {
        partners.map((partner) => (
          <div class="w-20 h-10 bg-gray-100 dark:bg-gray-800 rounded flex items-center justify-center">
            <span class="text-xs text-gray-500 dark:text-gray-400">{partner.name}</span>
          </div>
        ))
      }

      {/* Empty last column */}
      <div class="w-full"></div>
    </div>
  </div>
</footer>
