---
import { languages, defaultLang, routes } from '~/i18n/config';
import { getLangFromUrl } from '~/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const otherLang = lang === 'en' ? 'cy' : 'en';
const otherLangName = languages[otherLang];

// Get current path without language prefix
const currentPath = Astro.url.pathname;

// Special handling for home page and language-only paths
const targetUrl = currentPath === `/${lang}` || currentPath === '/' || currentPath === ''
  ? `/${otherLang}`
  : `/${otherLang}${currentPath.replace(/^\/(en|cy)/, '')}${Astro.url.search}`;
---

<a
  href={targetUrl}
  class="text-sm font-medium px-3 py-1 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
>
  {otherLangName}
</a>
