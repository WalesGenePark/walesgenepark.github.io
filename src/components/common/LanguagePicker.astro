---
import { languages } from '~/i18n/config';
import { getLangFromUrl, getLocalizedPath } from '~/i18n/utils';
import type { LanguageCode } from '~/i18n/routes';

const currentLang = getLangFromUrl(Astro.url) as LanguageCode;
const currentPath = Astro.url.pathname;
---

<div class="flex items-center">
  {
    Object.entries(languages).map(([lang, label]) => (
      <a
        href={getLocalizedPath(currentPath, lang as LanguageCode)}
        class={`px-3 py-1 text-sm font-medium rounded-full ${
          currentLang === lang
            ? 'bg-primary-600 text-white dark:bg-primary-400 dark:text-black'
            : 'text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white'
        }`}
      >
        {label}
      </a>
    ))
  }
</div>
