---
import { languages, defaultLang } from '~/i18n/config';
import { getLangFromUrl } from '~/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname;

function getAlternateLinks() {
  const alternates = [];
  const [, ...segments] = currentPath.split('/');
  
  // If we're on the default language path without the prefix
  if (!segments[0] || !(segments[0] in languages)) {
    for (const [code, label] of Object.entries(languages)) {
      if (code === defaultLang) continue;
      alternates.push({
        lang: code,
        label,
        href: `/${code}${currentPath}`,
      });
    }
  } else {
    // We're on a language-specific path
    for (const [code, label] of Object.entries(languages)) {
      if (code === segments[0]) continue;
      const href = code === defaultLang
        ? `/${segments.slice(1).join('/')}`
        : `/${code}/${segments.slice(1).join('/')}`;
      alternates.push({ lang: code, label, href });
    }
  }
  
  return alternates;
}

const alternates = getAlternateLinks();
---

<div class="flex items-center space-x-2">
  {alternates.map(({ lang: code, label, href }) => (
    <a
      href={href}
      class={`px-3 py-1 rounded-md text-sm font-medium transition-colors ${
        lang === code
          ? 'bg-primary text-white'
          : 'hover:bg-gray-100 dark:hover:bg-gray-800'
      }`}
      hreflang={code}
    >
      {code === 'en' ? 'English' : 'Cymraeg'}
    </a>
  ))}
</div>
