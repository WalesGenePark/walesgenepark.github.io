---
import { languages, defaultLang, routes } from '~/i18n/config';
import { getLangFromUrl } from '~/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const otherLang = lang === 'en' ? 'cy' : 'en';
const otherLangName = languages[otherLang];

// Get current path without language prefix
const currentPath = Astro.url.pathname.replace(/^\/(en|cy)\//, '/');

// Keep the English URL structure but change the language prefix
const targetUrl = `/${otherLang}${currentPath}${Astro.url.search}`;
---

<a
  href={targetUrl}
  class="text-sm font-medium px-3 py-1 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
>
  {otherLangName}
</a>
