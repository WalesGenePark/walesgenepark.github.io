---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import type { LanguageCode } from '~/i18n/routes';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((entry) => {
    const [lang, ...slugParts] = entry.slug.split('/');
    return {
      params: {
        lang: lang as LanguageCode,
        slug: slugParts.join('/'),
      },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const currentLang = getLangFromUrl(Astro.url) as LanguageCode;
const t = useTranslations(currentLang);

const formatTime = (time: string) => {
  return new Date(`1970-01-01T${time}`).toLocaleTimeString(currentLang === 'cy' ? 'cy' : 'en-GB', {
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  });
};

const metadata = {
  title: entry.data.title,
  description: entry.data.description,
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
    <div class="mb-8">
      <div class="inline-block mb-4">
        <span
          class="px-3 py-1 text-sm font-medium rounded-full bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200"
        >
          {t('content.tag.event')}
        </span>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">
        {entry.data.title}
      </h1>
    </div>

    <div class="flex flex-wrap gap-4 mb-8">
      <p class="text-lg text-gray-600 dark:text-slate-400 flex items-center">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 mr-2"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        {
          new Date(entry.data.date).toLocaleDateString(currentLang === 'cy' ? 'cy' : 'en-GB', {
            weekday: 'long',
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })
        }
      </p>
      {
        entry.data.startTime && (
          <p class="text-lg text-gray-600 dark:text-slate-400 flex items-center">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 mr-2"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            {formatTime(entry.data.startTime)}
            {entry.data.endTime && ` - ${formatTime(entry.data.endTime)}`}
          </p>
        )
      }
      {
        entry.data.location && (
          <p class="text-lg text-gray-600 dark:text-slate-400 flex items-center">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 mr-2"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              />
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
              />
            </svg>
            {entry.data.location}
          </p>
        )
      }
    </div>

    {entry.data.image && <img src={entry.data.image} alt={entry.data.title} class="w-full rounded-lg shadow-lg mb-8" />}

    <article class="prose prose-lg max-w-none dark:prose-invert">
      <Content />
    </article>
  </section>
</Layout>
