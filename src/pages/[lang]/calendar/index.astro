---
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import { Icon } from 'astro-icon/components';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'cy' } },
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const metadata = {
  title: t('nav.calendar'),
};

// Get events
const events = await getCollection('events', ({ id }) => {
  return id.startsWith(lang + '/');
});

// Sort events by date and time
const sortedEvents = events.sort((a, b) => {
  const dateA = new Date(a.data.date);
  const dateB = new Date(b.data.date);
  if (dateA.getTime() === dateB.getTime()) {
    const timeA = a.data.startTime || '';
    const timeB = b.data.startTime || '';
    return timeA.localeCompare(timeB);
  }
  return dateA.getTime() - dateB.getTime();
});

// Split events into upcoming and past
const today = new Date();
today.setHours(0, 0, 0, 0);

const { upcomingEvents, pastEvents } = sortedEvents.reduce(
  (acc, event) => {
    const eventDate = new Date(event.data.date);
    eventDate.setHours(0, 0, 0, 0);
    
    if (eventDate >= today) {
      acc.upcomingEvents.push(event);
    } else {
      acc.pastEvents.push(event);
    }
    
    return acc;
  },
  { upcomingEvents: [], pastEvents: [] }
);

// Reverse past events to show most recent first
pastEvents.reverse();

const labels = {
  en: {
    upcomingEvents: 'Upcoming Events',
    pastEvents: 'Past Events',
    showPastEvents: 'Show Past Events',
    hidePastEvents: 'Hide Past Events',
    noUpcomingEvents: 'No upcoming events scheduled',
    noPastEvents: 'No past events',
  },
  cy: {
    upcomingEvents: 'Digwyddiadau i Ddod',
    pastEvents: 'Digwyddiadau Blaenorol',
    showPastEvents: 'Dangos Digwyddiadau Blaenorol',
    hidePastEvents: 'Cuddio Digwyddiadau Blaenorol',
    noUpcomingEvents: 'Dim digwyddiadau wedi\'u trefnu',
    noPastEvents: 'Dim digwyddiadau blaenorol',
  }
};

function formatDate(date: Date, lang: string): string {
  const options: Intl.DateTimeFormatOptions = {
    weekday: 'long',
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  };
  return date.toLocaleDateString(lang === 'cy' ? 'cy-GB' : 'en-GB', options);
}
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-6xl">
    <div class="mb-8">
      <h1 class="text-4xl font-bold mb-2">{t('nav.calendar')}</h1>
      <p class="text-gray-600 dark:text-gray-400">
        {upcomingEvents.length} {lang === 'en' ? 'upcoming events' : 'digwyddiadau i ddod'}
      </p>
    </div>

    <!-- Upcoming Events -->
    <div class="space-y-12 mb-16">
      <h2 class="text-2xl font-bold text-primary">
        {labels[lang as keyof typeof labels].upcomingEvents}
      </h2>

      {upcomingEvents.length > 0 ? (
        <div class="space-y-8">
          {upcomingEvents.map((event) => {
            const date = new Date(event.data.date);
            const startTime = event.data.startTime || '';
            const endTime = event.data.endTime || '';
            const timeDisplay = startTime && endTime ? `${startTime} - ${endTime}` : startTime || '';

            return (
              <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
                <a href={`/${lang}/events/${event.slug.split('/')[1]}`} class="block p-6">
                  <div class="flex items-start space-x-4">
                    <div class="flex-shrink-0 w-16 text-center">
                      <div class="text-2xl font-bold text-primary">{date.getDate()}</div>
                      <div class="text-sm text-gray-600 dark:text-gray-400">
                        {date.toLocaleDateString(lang === 'cy' ? 'cy-GB' : 'en-GB', { month: 'short' })}
                      </div>
                    </div>
                    
                    <div class="flex-grow">
                      <h3 class="text-xl font-bold mb-2 group-hover:text-primary">
                        {event.data.title}
                      </h3>
                      
                      <div class="space-y-2">
                        <div class="flex items-center text-gray-600 dark:text-gray-400">
                          <Icon name="tabler:calendar" class="w-4 h-4 mr-2" />
                          <span class="text-sm">{formatDate(date, lang)}</span>
                        </div>

                        {timeDisplay && (
                          <div class="flex items-center text-gray-600 dark:text-gray-400">
                            <Icon name="tabler:clock" class="w-4 h-4 mr-2" />
                            <span class="text-sm">{timeDisplay}</span>
                          </div>
                        )}

                        {event.data.location && (
                          <div class="flex items-center text-gray-600 dark:text-gray-400">
                            <Icon name="tabler:map-pin" class="w-4 h-4 mr-2" />
                            <span class="text-sm">{event.data.location}</span>
                          </div>
                        )}
                      </div>
                    </div>

                    <div class="flex-shrink-0">
                      <Icon name="tabler:chevron-right" class="w-6 h-6 text-gray-400" />
                    </div>
                  </div>
                </a>
              </div>
            );
          })}
        </div>
      ) : (
        <p class="text-gray-600 dark:text-gray-400 text-center py-8">
          {labels[lang as keyof typeof labels].noUpcomingEvents}
        </p>
      )}
    </div>

    <!-- Past Events -->
    <div class="space-y-8">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-bold text-gray-600 dark:text-gray-400">
          {labels[lang as keyof typeof labels].pastEvents}
        </h2>

        <button
          id="togglePastEvents"
          class="text-sm font-medium px-4 py-2 rounded-lg bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors"
          aria-expanded="true"
          data-show-text={labels[lang as keyof typeof labels].showPastEvents}
          data-hide-text={labels[lang as keyof typeof labels].hidePastEvents}
        >
          {labels[lang as keyof typeof labels].hidePastEvents}
        </button>
      </div>

      <div id="pastEvents" class="space-y-6">
        {pastEvents.length > 0 ? (
          <div class="space-y-4">
            {pastEvents.map((event) => {
              const date = new Date(event.data.date);
              const startTime = event.data.startTime || '';
              const endTime = event.data.endTime || '';
              const timeDisplay = startTime && endTime ? `${startTime} - ${endTime}` : startTime || '';

              return (
                <div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4">
                  <a href={`/${lang}/events/${event.slug.split('/')[1]}`} class="block group">
                    <div class="flex items-center space-x-4">
                      <div class="flex-shrink-0 w-16 text-center">
                        <div class="text-xl font-bold text-gray-400">{date.getDate()}</div>
                        <div class="text-sm text-gray-400">
                          {date.toLocaleDateString(lang === 'cy' ? 'cy-GB' : 'en-GB', { month: 'short' })}
                        </div>
                      </div>
                      
                      <div class="flex-grow">
                        <h3 class="text-lg font-bold text-gray-600 dark:text-gray-400 group-hover:text-primary">
                          {event.data.title}
                        </h3>
                        
                        <div class="flex items-center text-gray-500 dark:text-gray-500 mt-1">
                          <Icon name="tabler:calendar" class="w-4 h-4 mr-2" />
                          <span class="text-sm">{formatDate(date, lang)}</span>
                          
                          {timeDisplay && (
                            <>
                              <span class="mx-2">•</span>
                              <Icon name="tabler:clock" class="w-4 h-4 mr-2" />
                              <span class="text-sm">{timeDisplay}</span>
                            </>
                          )}
                        </div>
                      </div>

                      <div class="flex-shrink-0">
                        <Icon name="tabler:chevron-right" class="w-5 h-5 text-gray-400" />
                      </div>
                    </div>
                  </a>
                </div>
              );
            })}
          </div>
        ) : (
          <p class="text-gray-600 dark:text-gray-400 text-center py-8">
            {labels[lang as keyof typeof labels].noPastEvents}
          </p>
        )}
      </div>
    </div>
  </section>
</Layout>

<script>
function initializeEventList() {
  const toggleButton = document.getElementById('togglePastEvents');
  const pastEventsSection = document.getElementById('pastEvents');
  
  if (!toggleButton || !pastEventsSection) return;

  function updateToggleState(isExpanded) {
    toggleButton.setAttribute('aria-expanded', isExpanded.toString());
    toggleButton.textContent = isExpanded 
      ? toggleButton.getAttribute('data-hide-text')
      : toggleButton.getAttribute('data-show-text');
    pastEventsSection.style.display = isExpanded ? 'block' : 'none';
  }

  // Show past events by default
  updateToggleState(true);

  toggleButton.addEventListener('click', () => {
    const isCurrentlyExpanded = toggleButton.getAttribute('aria-expanded') === 'true';
    updateToggleState(!isCurrentlyExpanded);
  });
}

// Initialize when the DOM is ready
document.addEventListener('DOMContentLoaded', initializeEventList);

// Re-initialize when Astro updates the page
document.addEventListener('astro:page-load', initializeEventList);
</script>
