---
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'cy' } },
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const metadata = {
  title: t('nav.team'),
};

const teamMembers = await getCollection('team', ({ id }) => {
  return id.startsWith(lang + '/');
});

// Sort team members by their file name (which starts with a number)
const sortedTeamMembers = teamMembers.sort((a, b) => {
  const aNum = parseInt(a.id.split('/')[1].split('-')[0]);
  const bNum = parseInt(b.id.split('/')[1].split('-')[0]);
  return aNum - bNum;
});
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-6xl">
    <h1 class="text-4xl font-bold mb-10">{t('nav.team')}</h1>
    
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {sortedTeamMembers.map((member) => (
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden">
          {member.data.image ? (
            <img
              src={member.data.image}
              alt={member.data.name}
              class="w-full h-64 object-cover"
            />
          ) : (
            <div class="w-full h-64 bg-gray-200 dark:bg-gray-700"></div>
          )}
          <div class="p-6">
            <h2 class="text-xl font-semibold mb-2">{member.data.name}</h2>
            <p class="text-gray-600 dark:text-gray-400 mb-4">{member.data.title}</p>
            {member.data.description && (
              <p class="text-gray-700 dark:text-gray-300">
                {member.data.description}
              </p>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
