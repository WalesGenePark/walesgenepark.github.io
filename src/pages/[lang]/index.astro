---
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl } from '~/i18n/utils';
import { sectionRoutes } from '~/i18n/routes';
import NewsCarousel from '~/components/widgets/NewsCarousel.astro';
import Hero from '~/components/widgets/Hero.astro';
import Services from '~/components/widgets/Services.astro';
import type { NewsEntry, EventEntry } from '~/types/content';
import type { MetaData } from '~/types/metaData';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'cy' } }];
}

const lang = getLangFromUrl(Astro.url);

const metadata: MetaData = {
  title: 'Wales Gene Park',
};

const content = {
  en: {
    title: 'Advancing Genomic Medicine in Wales',
    description:
      'Wales Gene Park is dedicated to supporting healthcare professionals, researchers, and the public in understanding and advancing genetic medicine. We provide state-of-the-art genomic services, research support, and educational programs.',
    cta: {
      primary: {
        text: 'Our Services',
        href: '/en/services',
      },
      secondary: {
        text: 'Contact Us',
        href: '/en/contact',
      },
    },
    newsAndEvents: {
      title: 'Latest News & Events',
      news: {
        text: 'View All News',
        href: '/en/news',
      },
      events: {
        text: 'View All Events',
        href: '/en/events',
      },
    },
  },
  cy: {
    title: 'Hyrwyddo Meddygaeth Genomig yng Nghymru',
    description:
      "Mae Parc Genynnau Cymru yn ymroddedig i gefnogi gweithwyr gofal iechyd proffesiynol, ymchwilwyr, a'r cyhoedd i ddeall a datblygu meddygaeth enetig. Rydym yn darparu gwasanaethau genomig o'r radd flaenaf, cymorth ymchwil, a rhaglenni addysgol.",
    cta: {
      primary: {
        text: 'Ein Gwasanaethau',
        href: '/cy/services',
      },
      secondary: {
        text: 'Cysylltu â Ni',
        href: '/cy/contact',
      },
    },
    newsAndEvents: {
      title: 'Newyddion a Digwyddiadau Diweddaraf',
      news: {
        text: 'Gweld Pob Newyddion',
        href: '/cy/news',
      },
      events: {
        text: 'Gweld Pob Digwyddiad',
        href: '/cy/events',
      },
    },
  },
};

// Get news and events for the carousel
const newsEntries = await getCollection('news', ({ id }) => {
  return id.startsWith(lang + '/');
}).then((entries) => entries as unknown as NewsEntry[]);

const eventsEntries = await getCollection('events', ({ id }) => {
  return id.startsWith(lang + '/');
}).then((entries) => entries as unknown as EventEntry[]);

interface EntryWithMTime {
  mtime: Date;
  entry: NewsEntry | EventEntry;
}

// Add file stats to entries
const entriesWithStats: EntryWithMTime[] = await Promise.all([
  ...newsEntries.map(async (entry) => ({
    entry,
    mtime: new Date(entry.data.publishDate),
  })),
  ...eventsEntries.map(async (entry) => ({
    entry,
    mtime: new Date(entry.data.date),
  })),
]);

// Sort by file modification time
const sortedEntries = entriesWithStats.sort((a, b) => {
  return b.mtime.getTime() - a.mtime.getTime();
});

// Take the first 15 items
const carouselItems = sortedEntries.slice(0, 15).map((item) => item.entry);
---

<Layout metadata={metadata}>
  <div>
    <Hero
      title={content[lang].title}
      subtitle={content[lang].description}
      actions={[
        {
          variant: 'primary',
          text: lang === 'en' ? 'Our Services' : 'Ein Gwasanaethau',
          href: '#services', // Changed to anchor link
        },
        {
          variant: 'secondary',
          text: lang === 'en' ? 'Contact Us' : 'Cysylltwch â ni',
          href: `/${lang}/${sectionRoutes.contact[lang]}`,
        },
      ]}
    />

    <Services />

    <section class="px-4 sm:px-6 mx-auto lg:px-8 max-w-4xl mt-8">
      <div class="flex items-center justify-center mb-4">
        <h2 class="text-3xl font-bold">{content[lang].newsAndEvents.title}</h2>
      </div>
      <div class="flex gap-4 mb-1 justify-center">
        <a href={content[lang].newsAndEvents.news.href} class="text-primary-600 hover:underline">
          {content[lang].newsAndEvents.news.text}
        </a>
        <a href={content[lang].newsAndEvents.events.href} class="text-primary-600 hover:underline">
          {content[lang].newsAndEvents.events.text}
        </a>
      </div>
    </section>
  </div>

  <NewsCarousel items={carouselItems} />
</Layout>
