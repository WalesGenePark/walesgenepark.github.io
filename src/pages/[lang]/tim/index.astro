---
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import { Icon } from 'astro-icon/components';

export function getStaticPaths() {
  return [
    { params: { lang: 'cy' } },
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const metadata = {
  title: t('nav.team'),
};

const teams = {
  leadership: {
    en: 'Leadership Team',
    cy: 'Tîm Arweinyddiaeth',
  },
  research: {
    en: 'Research Team',
    cy: 'Tîm Ymchwil',
  },
  clinical: {
    en: 'Clinical Team',
    cy: 'Tîm Clinigol',
  },
  support: {
    en: 'Support Team',
    cy: 'Tîm Cymorth',
  },
};

const members = await getCollection('team', ({ id }) => {
  return id.startsWith(lang + '/');
});

const teamMembers = Object.keys(teams).reduce((acc, team) => {
  acc[team] = members.filter(member => member.data.team === team);
  return acc;
}, {} as Record<string, typeof members>);
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-6xl">
    <h1 class="text-4xl font-bold mb-10">{t('nav.team')}</h1>

    {Object.entries(teams).map(([teamKey, teamNames]) => (
      <div class="mb-16">
        <h2 class="text-3xl font-bold mb-8">{teamNames[lang as keyof typeof teamNames]}</h2>
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {teamMembers[teamKey].map((member) => (
            <div class="flex flex-col items-center">
              <div class="mb-4">
                <img
                  src={member.data.avatar || '/images/default-avatar.jpg'}
                  alt={member.data.name}
                  class="w-40 h-40 rounded-full object-cover"
                />
              </div>
              <h3 class="text-xl font-semibold text-center mb-2">{member.data.name}</h3>
              <p class="text-gray-600 dark:text-gray-400 text-center mb-2">{member.data.title}</p>
              <p class="text-gray-600 dark:text-gray-400 text-center mb-4 px-4">{member.data.bio}</p>
              <div class="flex space-x-4">
                {member.data.email && (
                  <a href={`mailto:${member.data.email}`} class="text-gray-500 hover:text-primary">
                    <Icon name="tabler:mail" class="w-5 h-5" />
                  </a>
                )}
                {member.data.twitter && (
                  <a href={member.data.twitter} class="text-gray-500 hover:text-primary" target="_blank" rel="noopener">
                    <Icon name="tabler:brand-twitter" class="w-5 h-5" />
                  </a>
                )}
                {member.data.linkedin && (
                  <a href={member.data.linkedin} class="text-gray-500 hover:text-primary" target="_blank" rel="noopener">
                    <Icon name="tabler:brand-linkedin" class="w-5 h-5" />
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>
</Layout>
