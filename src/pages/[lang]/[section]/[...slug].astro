---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import ContentRouter from '~/components/content/ContentRouter.astro';
import { isValidSection, getAlternateSection, getSectionTitle } from '~/i18n/routes';
import type { LanguageCode } from '~/i18n/routes';
import type { ContentEntry } from '~/types/content';

export async function getStaticPaths() {
  const collections = ['news', 'events', 'team'] as const;
  const paths: Array<{
    params: {
      lang: 'en' | 'cy';
      section: (typeof collections)[number];
      slug: string;
    };
    props: { entry: ContentEntry };
  }> = [];

  for (const collection of collections) {
    const entries = await getCollection(collection);

    for (const entry of entries) {
      const [lang, ...slugParts] = entry.slug.split('/');

      if (lang === 'en' || lang === 'cy') {
        paths.push({
          params: {
            lang,
            section: collection,
            slug: slugParts.join('/'),
          },
          props: { entry },
        });
      }
    }
  }

  return paths;
}

interface Props {
  entry: ContentEntry;
}

const { lang, section, slug } = Astro.params;
const { entry } = Astro.props;

// Validate parameters
if (!entry || !lang || !section || !isValidSection(section)) {
  return Astro.redirect(`/${lang || 'en'}/404`);
}

// Ensure the entry matches the section
if (entry.collection !== section) {
  return Astro.redirect(`/${lang}/404`);
}

// Ensure the language matches
const [entryLang] = entry.slug.split('/');
if (entryLang !== lang) {
  return Astro.redirect(`/${lang}/404`);
}

const alternateSection = getAlternateSection(section, lang as LanguageCode);
const sectionTitle = getSectionTitle(section, lang as LanguageCode);

// Generate the alternate language URL
const alternateSlug = slug;
const alternateLanguage = lang === 'en' ? 'cy' : 'en';

const metadata = {
  title: `${entry.data.title} | ${sectionTitle}`,
  description: 'description' in entry.data ? entry.data.description : '',
  alternateLinks: [
    {
      href: `/${alternateLanguage}/${alternateSection}/${alternateSlug}`,
      hreflang: alternateLanguage,
    },
  ],
  openGraph: {
    title: entry.data.title,
    description: 'description' in entry.data ? entry.data.description : '',
    type: 'article',
    url: `${Astro.site}${lang}/${section}/${slug}`,
    image: 'image' in entry.data ? entry.data.image : undefined,
  },
} as const;
---

<Layout metadata={metadata}>
  <ContentRouter entry={entry} />
</Layout>
