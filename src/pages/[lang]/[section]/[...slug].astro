---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import { isValidSection, getAlternateSection, getSectionTitle, sectionRoutes } from '~/i18n/routes';
import type { LanguageCode } from '~/i18n/routes';
import type { ContentEntry } from '~/types/content';

export async function getStaticPaths() {
  const collections = ['news', 'events', 'team', 'policy'];
  const languages: LanguageCode[] = ['en', 'cy'];
  const paths: any[] = [];

  for (const collection of collections) {
    const entries = await getCollection(collection);
    
    for (const entry of entries) {
      // Extract language from the entry's slug (assuming format: lang/rest-of-slug)
      const [entryLang, ...slugParts] = entry.slug.split('/');
      const lang = entryLang as LanguageCode;
      
      if (languages.includes(lang)) {
        paths.push({
          params: {
            lang,
            section: collection,
            slug: slugParts.join('/')
          },
          props: { entry }
        });
      }
    }
  }

  return paths;
}

const { lang, section, slug } = Astro.params;
const { entry } = Astro.props;

if (!entry || !isValidSection(section)) {
  return Astro.redirect(`/${lang}/404`);
}

const t = useTranslations(lang as LanguageCode);
const alternateSection = getAlternateSection(section, lang === 'en' ? 'cy' : 'en');
const sectionTitle = getSectionTitle(section, lang as LanguageCode);

const metadata = {
  title: `${entry.data.title} | ${sectionTitle}`,
  description: entry.data.description || '',
  openGraph: {
    title: entry.data.title,
    description: entry.data.description || '',
    image: entry.data.image || '',
    type: 'article'
  },
  twitter: {
    title: entry.data.title,
    description: entry.data.description || '',
    image: entry.data.image || '',
    card: 'summary_large_image'
  },
  alternateLinks: [
    {
      href: `/${lang === 'en' ? 'cy' : 'en'}/${alternateSection}/${slug}`,
      hreflang: lang === 'en' ? 'cy' : 'en'
    }
  ]
};

const { Content } = await entry.render();
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
    <h1 class="text-center font-bold leading-tighter tracking-tighter font-heading text-4xl md:text-5xl mb-8">
      {entry.data.title}
    </h1>
    
    {entry.data.image && (
      <img
        src={entry.data.image}
        class="mx-auto rounded-md shadow-lg mb-6"
        alt={entry.data.description || ''}
        loading="lazy"
      />
    )}

    <div class="mx-auto prose dark:prose-invert max-w-4xl">
      <Content />
    </div>
  </section>
</Layout>
