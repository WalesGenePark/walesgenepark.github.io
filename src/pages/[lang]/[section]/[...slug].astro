---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import { isValidSection, getAlternateSection, getSectionTitle } from '~/i18n/routes';
import type { LanguageCode } from '~/i18n/routes';
import type { ContentEntry } from '~/types/content';

export async function getStaticPaths() {
  const collections = ['news', 'events', 'team', 'policy'];
  const paths = [];

  for (const collection of collections) {
    const entries = await getCollection(collection);
    
    for (const entry of entries) {
      const [lang, ...slugParts] = entry.slug.split('/');
      
      if (lang === 'en' || lang === 'cy') {
        paths.push({
          params: {
            lang,
            section: collection,
            slug: slugParts.join('/')
          },
          props: { entry }
        });
      }
    }
  }

  return paths;
}

const { lang, section, slug } = Astro.params;
const { entry } = Astro.props;

if (!entry || !lang || !section || !isValidSection(section)) {
  return Astro.redirect(`/${lang || 'en'}/404`);
}

const t = useTranslations(lang as LanguageCode);
const alternateSection = getAlternateSection(section, lang as LanguageCode);
const sectionTitle = getSectionTitle(section, lang as LanguageCode);

const metadata = {
  title: `${entry.data.title} | ${sectionTitle}`,
  description: entry.data.description || '',
  alternateLinks: [
    {
      href: `/${lang === 'en' ? 'cy' : 'en'}/${alternateSection}/${slug}`,
      hreflang: lang === 'en' ? 'cy' : 'en'
    }
  ],
  openGraph: {
    title: entry.data.title,
    description: entry.data.description || '',
    type: 'article',
    url: `${Astro.site}${lang}/${section}/${slug}`
  }
};

const { Content } = await entry.render();
---

<Layout metadata={metadata}>
  <article class="mx-auto max-w-4xl px-4 py-16 lg:py-20">
    <div class="mb-10">
      <h1 class="text-center font-bold leading-tighter tracking-tighter font-heading text-4xl md:text-5xl">
        {entry.data.title}
      </h1>
    </div>
    {entry.data.image && (
      <img
        src={entry.data.image}
        class="mx-auto rounded-md shadow-lg mb-6"
        alt={entry.data.description || ''}
        loading="lazy"
      />
    )}
    <div class="mx-auto prose dark:prose-invert max-w-4xl">
      <Content />
    </div>
  </article>
</Layout>
