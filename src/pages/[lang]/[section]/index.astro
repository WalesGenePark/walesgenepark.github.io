---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import ContentRouter from '~/components/content/ContentRouter.astro';
import News from '~/components/widgets/News.astro';
import Events from '~/components/widgets/Events.astro';
import ContactPage from '~/components/widgets/ContactPage.astro';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import { languages } from '~/i18n/config';
import { isValidSection, getAlternateSection, getSectionTitle, sectionRoutes } from '~/i18n/routes';
import type { LanguageCode } from '~/i18n/routes';
import type { MetaData } from '~/types/metaData';
import type { ContentEntry } from '~/types/content';

// Get static paths for all sections and languages
export async function getStaticPaths() {
  const sections = ['privacy', 'cookies', 'news', 'events', 'contact'];
  return sections.flatMap((section) =>
    languages.map((lang) => ({
      params: { lang, section },
    }))
  );
}

// Get current language and section from URL
const { lang, section } = Astro.params;
const currentLang = lang as LanguageCode;
const t = useTranslations(currentLang);

// Validate language
if (!['en', 'cy'].includes(currentLang)) {
  return Astro.redirect('/404');
}

if (!isValidSection(section)) {
  return Astro.redirect(`/${currentLang}/404`);
}

// Handle different section types
let entry;
let entries;

if (section === 'privacy' || section === 'cookies') {
  entries = await getCollection(section, ({ id }) => {
    return id.startsWith(`${currentLang}/`);
  });
  entry = entries[0];
  
  // Handle 404 for policy pages
  if (!entry) {
    return Astro.redirect(`/${currentLang}/404`);
  }
}

// Set metadata
const alternateSection = getAlternateSection(section, currentLang);
const metadata: MetaData = {
  title: entry?.data.title || getSectionTitle(section, currentLang),
  description: entry?.data.description || t(`meta.${section}.description`),
  alternateLinks: [
    {
      href: `/${currentLang === 'en' ? 'cy' : 'en'}/${alternateSection}`,
      hreflang: currentLang === 'en' ? 'cy' : 'en',
    },
  ],
  openGraph: {
    title: entry?.data.title || getSectionTitle(section, currentLang),
    description: entry?.data.description || t(`meta.${section}.description`),
    type: 'website',
    url: `${Astro.site}${currentLang}/${section}`,
  },
};
---

<Layout metadata={metadata}>
  {section === 'privacy' && <ContentRouter entry={entry} />}
  {section === 'cookies' && <ContentRouter entry={entry} />}
  {section === 'news' && <News />}
  {section === 'events' && <Events />}
  {section === 'contact' && <ContactPage />}
</Layout>
