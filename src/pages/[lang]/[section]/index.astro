---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import Team from '~/components/widgets/Team.astro';
import News from '~/components/widgets/News.astro';
import Events from '~/components/widgets/Events.astro';
import Contact from '~/components/widgets/Contact.astro';
import Services from '~/components/widgets/Services.astro';
import ContentRouter from '~/components/content/ContentRouter.astro';
import { isValidSection, getAlternateSection, getSectionTitle } from '~/i18n/routes';
import type { LanguageCode } from '~/i18n/routes';
import type { MetaData } from '~/types/metaData';
import type { CollectionEntry } from 'astro:content';

// Get static paths for all sections and languages
export function getStaticPaths() {
  const sections = ['team', 'news', 'events', 'privacy', 'cookies', 'contact', 'services'] as const;
  const languages = ['en', 'cy'] as const;

  return sections.flatMap((section) =>
    languages.map((lang) => ({
      params: { lang, section },
    }))
  );
}

// Get current language and section from URL
const { lang, section } = Astro.params;

if (!lang || !section || !isValidSection(section)) {
  return Astro.redirect(`/${lang || 'en'}/404`);
}

const alternateSection = getAlternateSection(section, lang as LanguageCode);
const sectionTitle = getSectionTitle(section, lang as LanguageCode);

let entry: CollectionEntry<'privacy' | 'cookies'> | null = null;

if (section === 'privacy' || section === 'cookies') {
  const entries = await getCollection(section);
  entry = entries.find((e) => e.slug.startsWith(lang)) || null;
}

// Set metadata
const metadata: MetaData = {
  title: entry?.data.title || sectionTitle,
  description: entry?.data.description || sectionTitle,
  alternateLinks: [
    {
      href: `/${lang === 'en' ? 'cy' : 'en'}/${alternateSection}`,
      hreflang: lang === 'en' ? 'cy' : 'en',
    },
  ],
  openGraph: {
    title: entry?.data.title || sectionTitle,
    description: entry?.data.description || sectionTitle,
    type: 'website',
    url: `${Astro.site}${lang}/${section}`,
  },
};
---

<Layout metadata={metadata}>
  {section === 'team' && <Team lang={lang} />}
  {section === 'news' && <News lang={lang} />}
  {section === 'events' && <Events lang={lang} />}
  {section === 'contact' && <Contact lang={lang} />}
  {section === 'services' && <Services lang={lang} />}
  {(section === 'privacy' || section === 'cookies') && entry && <ContentRouter entry={entry} />}
</Layout>
