---
import Layout from '~/layouts/PageLayout.astro';
import { useTranslations } from '~/i18n/utils';
import { isValidSection, getAlternateSection, getSectionTitle, sectionRoutes } from '~/i18n/routes';
import { languages } from '~/i18n/config';
import type { LanguageCode } from '~/i18n/routes';
import type { MetaData } from '~/types/metaData';
import ContactPage from '~/components/widgets/ContactPage.astro';
import Events from '~/components/widgets/Events.astro';
import News from '~/components/widgets/News.astro';
import Team from '~/components/widgets/Team.astro';
import Policy from '~/components/widgets/Policy.astro';

// Get static paths
export function getStaticPaths() {
  return Object.entries(sectionRoutes).flatMap(([section]) =>
    languages.map(lang => ({
      params: { lang, section }
    }))
  );
}

const { lang, section } = Astro.params;
const currentLang = lang as LanguageCode;

// Validate language
if (!['en', 'cy'].includes(currentLang)) {
  return Astro.redirect('/en');
}

const t = useTranslations(currentLang);

if (!isValidSection(section)) {
  return Astro.redirect(`/${currentLang}/404`);
}

const alternateSection = getAlternateSection(section, currentLang);

const metadata: MetaData = {
  title: getSectionTitle(section, currentLang),
  description: t('meta.description'),
  alternateLinks: [
    {
      href: `/${currentLang === 'en' ? 'cy' : 'en'}/${alternateSection}`,
      hreflang: currentLang === 'en' ? 'cy' : 'en'
    }
  ],
  openGraph: {
    title: getSectionTitle(section, currentLang),
    description: t('meta.description'),
    type: 'website',
    url: `${Astro.site}${currentLang}/${section}`
  }
};

// Map base sections to components
const baseComponents = {
  contact: ContactPage,
  events: Events,
  news: News,
  team: Team,
  privacy: Policy,
  cookies: Policy
} as const;

// Redirect /calendar to /events
if (section === 'calendar') {
  return Astro.redirect(`/${currentLang}/events`);
}

const SectionComponent = baseComponents[section as keyof typeof baseComponents];

if (!SectionComponent) {
  return Astro.redirect(`/${currentLang}/404`);
}
---

<Layout metadata={metadata}>
  <SectionComponent />
</Layout>
