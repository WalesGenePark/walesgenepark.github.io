---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import Team from '~/components/widgets/Team.astro';
import News from '~/components/widgets/News.astro';
import Events from '~/components/widgets/Events.astro';
import ContactPage from '~/components/widgets/ContactPage.astro';
import ContentRouter from '~/components/content/ContentRouter.astro';
import { useTranslations } from '~/i18n/utils';
import { isValidSection, getAlternateSection, getSectionTitle } from '~/i18n/routes';
import type { LanguageCode } from '~/i18n/routes';
import type { MetaData } from '~/types/metaData';
import type { CollectionEntry } from 'astro:content';

// Get static paths for all sections and languages
export async function getStaticPaths() {
  const sections = ['team', 'news', 'events', 'privacy', 'cookies'];
  return sections.flatMap((section) =>
    ['en', 'cy'].map((lang) => ({
      params: { lang, section },
    }))
  );
}

// Get current language and section from URL
const { lang, section } = Astro.params;

if (!lang || !section || !isValidSection(section)) {
  return Astro.redirect(`/${lang || 'en'}/404`);
}

const t = useTranslations(lang as LanguageCode);
const alternateSection = getAlternateSection(section, lang as LanguageCode);
const sectionTitle = getSectionTitle(section, lang as LanguageCode);

let entry: CollectionEntry<'privacy' | 'cookies'> | null = null;

if (section === 'privacy') {
  const privacyEntries = await getCollection('privacy');
  entry = privacyEntries.find(({ slug }) => slug.startsWith(lang + '/')) || null;
} else if (section === 'cookies') {
  const cookieEntries = await getCollection('cookies');
  entry = cookieEntries.find(({ slug }) => slug.startsWith(lang + '/')) || null;
}

// Set metadata
const metadata: MetaData = {
  title: entry?.data.title || sectionTitle,
  description: entry?.data.description || t(`meta.${section}.description`),
  alternateLinks: [
    {
      href: `/${lang === 'en' ? 'cy' : 'en'}/${alternateSection}`,
      hreflang: lang === 'en' ? 'cy' : 'en',
    },
  ],
  openGraph: {
    title: entry?.data.title || sectionTitle,
    description: entry?.data.description || t(`meta.${section}.description`),
    type: 'website',
    url: `${Astro.site}${lang}/${section}`,
  },
};
---

<Layout metadata={metadata}>
  {section === 'team' && <Team />}
  {section === 'news' && <News />}
  {section === 'events' && <Events />}
  {section === 'privacy' && entry && <ContentRouter entry={entry} />}
  {section === 'cookies' && entry && <ContentRouter entry={entry} />}
  {section === 'contact' && <ContactPage />}
</Layout>
