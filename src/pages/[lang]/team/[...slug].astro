---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import type { TeamEntry } from '~/types/content';

export async function getStaticPaths() {
  const team = await getCollection('team');
  return team.map((entry) => {
    const [lang, ...slugParts] = entry.slug.split('/');
    return {
      params: {
        lang,
        slug: slugParts.join('/'),
      },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { Content } = await entry.render();

const metadata = {
  title: `${entry.data.name} - ${entry.data.title}`,
  description: entry.data.bio,
  alternateLinks: [
    {
      href: `/${lang === 'en' ? 'cy' : 'en'}/team/${entry.slug.split('/').slice(1).join('/')}`,
      hreflang: lang === 'en' ? 'cy' : 'en',
    },
  ],
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 mx-auto max-w-6xl lg:py-20">
    <div class="flex flex-col md:flex-row gap-8">
      <div class="md:w-1/3">
        {
          entry.data.image && (
            <div class="relative w-48 h-48 mx-auto mb-6 overflow-hidden rounded-full border-4 border-primary-100 dark:border-primary-900">
              <img
                src={entry.data.image}
                class="w-full h-full object-cover"
                alt={entry.data.name}
                loading="lazy"
                decoding="async"
              />
            </div>
          )
        }
        <h1 class="text-3xl font-bold text-center mb-2">{entry.data.name}</h1>
        <p class="text-primary-600 dark:text-primary-400 font-medium text-center mb-1">{entry.data.title}</p>
        {entry.data.department && <p class="text-gray-600 dark:text-gray-400 text-center mb-4">{entry.data.department}</p>}
        
        <div class="flex justify-center gap-3 mt-4">
          {entry.data.email && (
            <a
              href={`mailto:${entry.data.email}`}
              class="text-gray-500 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400"
              title="Email"
            >
              <span class="sr-only">Email</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </a>
          )}
          {entry.data.socialLinks?.linkedin && (
            <a
              href={entry.data.socialLinks.linkedin}
              class="text-gray-500 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400"
              title="LinkedIn"
            >
              <span class="sr-only">LinkedIn</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </a>
          )}
        </div>
      </div>
      <div class="md:w-2/3">
        <div class="prose dark:prose-invert max-w-none">
          <Content />
        </div>
      </div>
    </div>
  </section>
</Layout>
