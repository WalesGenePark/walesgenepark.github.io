---
import Layout from '~/layouts/PageLayout.astro';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import type { MetaData } from '~/types/metaData';
import { languages } from '~/i18n/config';
import { Image } from 'astro:assets';

// Import images
import bioinformaticsMainImage from '~/assets/images/bioinformatics-service.jpg';
import bioinformaticsAnalysisImage from '~/assets/images/ngs-service.jpg';
import bioinformaticsDataImage from '~/assets/images/education-service.jpg';

export function getStaticPaths() {
  return languages.map((lang) => ({
    params: { lang },
  }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const metadata: MetaData = {
  title: t('nav.services') + ' - Bioinformatics',
  description: 'Advanced Bioinformatics Data Analysis and Interpretation',
  alternateLinks: [
    {
      href: `/${lang === 'en' ? 'cy' : 'en'}/services/bioinformatics`,
      hreflang: lang === 'en' ? 'cy' : 'en',
    },
  ],
};

const content = {
  en: {
    title: 'Bioinformatics Services',
    overview: 'Transforming complex genomic data into meaningful scientific insights through advanced computational techniques.',
    sections: [
      {
        title: 'Custom Pipeline Development',
        paragraphs: [
          'We design and implement tailored bioinformatics pipelines to meet the unique requirements of your research or clinical project, ensuring efficient and accurate data processing.',
          'Our pipelines are built using industry-standard tools and best practices, and are optimized for performance and scalability. We work closely with our clients to understand their specific needs and develop customized solutions that address their research questions.',
          'We have experience developing pipelines for a wide range of applications, including variant calling, RNA-seq analysis, ChIP-seq analysis, and metagenomics. Our pipelines are designed to be reproducible and transparent, and we provide comprehensive documentation to ensure that our clients can understand and utilize them effectively.'
        ],
        images: [
          { src: bioinformaticsMainImage, alt: 'Custom Pipeline Development' },
        ],
      },
      {
        title: 'Genomic Data Analysis',
        paragraphs: [
          'Our expert team provides comprehensive analysis services including variant calling, annotation, pathway analysis, and advanced statistical modeling of genomic datasets.',
          'We utilize a variety of bioinformatics tools and databases to analyze genomic data, and we stay up-to-date with the latest developments in the field. Our team has extensive experience in analyzing data from a wide range of sequencing platforms and technologies.',
          'We work closely with our clients to interpret the results of our analyses and to identify the most significant findings. We provide clear and concise reports that summarize the key results and their implications for research or clinical practice.'
        ],
        images: [
          { src: bioinformaticsAnalysisImage, alt: 'Genomic Data Analysis' },
        ],
      },
      {
        title: 'Data Interpretation & Reporting',
        paragraphs: [
          'We translate complex genomic data into clear, actionable insights, providing detailed reports and visualizations that support research and clinical decision-making.',
          'Our reports are designed to be accessible to both experts and non-experts, and we use a variety of visualization techniques to present the data in a clear and informative way. We also provide consultation services to discuss the findings and their implications.',
          'We are committed to providing our clients with the highest quality data interpretation and reporting services. Our goal is to help our clients make the most of their genomic data and to advance their research or clinical practice.'
        ],
        images: [
          { src: bioinformaticsDataImage, alt: 'Data Interpretation & Reporting' },
        ],
      }
    ]
  },
  cy: {
    title: 'Gwasanaethau Biowybodeg',
    overview: 'Trawsnewid data genomig cymhleth yn fewnwelediadau gwyddonol ystyrlon drwy dechnegau cyfrifiadurol uwch.',
    sections: [
      {
        title: 'Datblygu Piblinell Pwrpasol',
        paragraphs: [
          'Rydym yn dylunio ac yn gweithredu piblinellau biowybodeg wedi"u teilwra i ddiwallu gofynion unigryw eich prosiect ymchwil neu glinigol, gan sicrhau prosesu data effeithlon a chywir.',
          'Mae ein piblinellau wedi"u hadeiladu gan ddefnyddio offer safonol y diwydiant a\'r arferion gorau, ac maent wedi"u optimeiddio ar gyfer perfformiad a graddadwyedd. Rydym yn gweithio\'n agos gyda\'n cleientiaid i ddeall eu hanghenion penodol a datblygu atebion wedi\'u teilwra sy\'n mynd i\'r afael â\'u cwestiynau ymchwil.',
          'Mae gennym brofiad o ddatblygu piblinellau ar gyfer ystod eang o gymwysiadau, gan gynnwys galw amrywiolion, dadansoddi RNA-seq, dadansoddi ChIP-seq, a metagenomeg. Mae ein piblinellau wedi\'u cynllunio i fod yn atgynhyrchadwy ac yn dryloyw, ac rydym yn darparu dogfennaeth gynhwysfawr i sicrhau bod ein cleientiaid yn gallu eu deall a\'u defnyddio\'n effeithiol.'
        ],
        images: [
          { src: bioinformaticsMainImage, alt: 'Datblygu Piblinell Pwrpasol' },
        ],
      },
      {
        title: 'Dadansoddiad Data Genomig',
        paragraphs: [
          'Mae ein tîm arbenigol yn darparu gwasanaethau dadansoddi cynhwysfawr gan gynnwys galw amrywiolion, anodi, dadansoddi llwybrau, a modelu ystadegol uwch o setiau data genomig.',
          'Rydym yn defnyddio amrywiaeth o offer a chronfeydd data biowybodeg i ddadansoddi data genomig, ac rydym yn cadw i fyny â\'r datblygiadau diweddaraf yn y maes. Mae gan ein tîm brofiad helaeth o ddadansoddi data o ystod eang o blatfformau a thechnolegau dilyniannu.',
          'Rydym yn gweithio\'n agos gyda\'n cleientiaid i ddehongli canlyniadau ein dadansoddiadau ac i nodi\'r canfyddiadau mwyaf arwyddocaol. Rydym yn darparu adroddiadau clir a chryno sy\'n crynhoi\'r canlyniadau allweddol a\'u goblygiadau ar gyfer ymchwil neu ymarfer clinigol.'
        ],
        images: [
          { src: bioinformaticsAnalysisImage, alt: 'Dadansoddiad Data Genomig' },
        ],
      },
      {
        title: 'Dehongli a Adrodd Data',
        paragraphs: [
          'Rydym yn trosglwyddo data genomig cymhleth yn fewnwelediadau clir a gweithredol, gan ddarparu adroddiadau a delweddu manwl sy"n cefnogi ymchwil a phenderfyniadau clinigol.',
          'Mae ein hadroddiadau wedi\'u cynllunio i fod yn hygyrch i arbenigwyr a rhai nad ydynt yn arbenigwyr, ac rydym yn defnyddio amrywiaeth o dechnegau delweddu i gyflwyno\'r data mewn ffordd glir a llawn gwybodaeth. Rydym hefyd yn cynnig gwasanaethau ymgynghori i drafod y canfyddiadau a\'u goblygiadau.',
          'Rydym wedi ymrwymo i ddarparu\'r gwasanaethau dehongli ac adrodd data o\'r ansawdd uchaf i\'n cleientiaid. Ein nod yw helpu ein cleientiaid i wneud y gorau o\'u data genomig ac i hyrwyddo eu hymchwil neu eu hymarfer clinigol.'
        ],
        images: [
          { src: bioinformaticsDataImage, alt: 'Dehongli a Adrodd Data' },
        ],
      }
    ]
  }
};

const currentContent = content[lang];
---

<Layout metadata={metadata}>
  <section class="scroll-mt-16 px-4 py-16 mx-auto max-w-6xl lg:px-8 lg:py-20">
    <div class="mb-12 text-center">
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading text-red-500 dark:text-red-500">
        {currentContent.title}
      </h1>
      <p class="text-xl text-gray-600 dark:text-slate-400">
        {currentContent.overview}
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-1">
      {currentContent.sections.map((section) => (
        <div class="relative flex flex-col p-6 bg-white dark:bg-slate-900 rounded-lg shadow-lg">
          <h3 class="text-xl font-bold mb-2">{section.title}</h3>
          {section.paragraphs.map((paragraph) => (
            <p class="text-gray-600 dark:text-slate-400 mb-4">{paragraph}</p>
          ))}
          <div class="grid grid-cols-1 gap-4 mt-4">
            {section.images.map((image) => (
              <Image
                src={image.src}
                alt={image.alt}
                class="w-full object-cover rounded-lg"
              />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
