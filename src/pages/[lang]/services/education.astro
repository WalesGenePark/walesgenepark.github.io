---
import Layout from '~/layouts/PageLayout.astro';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import type { MetaData } from '~/types/metaData';
import { languages } from '~/i18n/config';
import { Image } from 'astro:assets';

// Import images
import educationMainImage from '~/assets/images/education-service.jpg';
import educationWorkshopImage from '~/assets/images/ngs-service.jpg';
import educationEngagementImage from '~/assets/images/bioinformatics-service.jpg';

export function getStaticPaths() {
  return languages.map((lang) => ({
    params: { lang },
  }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const metadata: MetaData = {
  title: t('nav.services') + ' - Education & Engagement',
  description: 'Comprehensive Genomics Education and Public Engagement Programs',
  alternateLinks: [
    {
      href: `/${lang === 'en' ? 'cy' : 'en'}/services/education`,
      hreflang: lang === 'en' ? 'cy' : 'en',
    },
  ],
};

const content = {
  en: {
    title: 'Education & Engagement Services',
    overview: 'Empowering understanding of genetics and genomics through innovative educational programs and public engagement initiatives.',
    sections: [
      {
        title: 'Professional Training',
        paragraphs: [
          'Tailored workshops and training sessions for healthcare professionals, researchers, and students, covering the latest advances in genomic technologies and their clinical applications.',
          'Our training programs are designed to be interactive and engaging, providing participants with hands-on experience and practical skills. We cover a wide range of topics, including genomic data analysis, interpretation of genetic variants, and ethical considerations in genomics.',
          'We also offer customized training programs to meet the specific needs of different organizations and institutions. Our expert trainers work closely with clients to develop and deliver programs that are tailored to their specific goals and objectives.'
        ],
        images: [
          { src: educationMainImage, alt: 'Professional Training' },
        ],
      },
      {
        title: 'Public Outreach',
        paragraphs: [
          'Engaging community programs that demystify genomics, including public lectures, interactive workshops, and collaborative events to promote scientific literacy.',
          'We believe that it is important to make genomics accessible to everyone, and our public outreach programs are designed to do just that. We work with schools, community groups, and other organizations to deliver engaging and informative programs that are tailored to the specific audience.',
          'Our programs cover a wide range of topics, from the basics of DNA to the latest advances in genomic research. We also address the ethical, legal, and social implications of genomics, and we encourage open discussion and debate about these important issues.'
        ],
        images: [
          { src: educationWorkshopImage, alt: 'Public Outreach' },
        ],
      },
      {
        title: 'School and University Partnerships',
        paragraphs: [
          'Collaborative educational initiatives with academic institutions to inspire the next generation of genomics researchers and healthcare professionals.',
          'We work closely with schools and universities to develop and deliver educational programs that are aligned with the curriculum and that inspire students to pursue careers in genomics. We offer a variety of programs, including guest lectures, workshops, and mentoring opportunities.',
          'We also provide resources and support for teachers and educators who are interested in incorporating genomics into their teaching. Our goal is to help build a strong foundation in genomics education and to foster the development of the next generation of genomics leaders.'
        ],
        images: [
          { src: educationEngagementImage, alt: 'School and University Partnerships' },
        ],
      }
    ]
  },
  cy: {
    title: 'Gwasanaethau Addysg ac Ymgysylltu',
    overview: 'Grymuso dealltwriaeth o eneteg a genomeg drwy raglenni addysgol arloesol a mentrau ymgysylltu cyhoeddus.',
    sections: [
      {
        title: 'Hyfforddiant Proffesiynol',
        paragraphs: [
          'Gweithdai a sesiynau hyfforddi wedi"u teilwra ar gyfer gweithwyr gofal iechyd, ymchwilwyr, a myfyrwyr, yn cwmpasu"r datblygiadau diweddaraf mewn technolegau genomig a"u cymwysiadau clinigol.',
          'Mae ein rhaglenni hyfforddi wedi"u cynllunio i fod yn rhyngweithiol a diddorol, gan roi profiad ymarferol a sgiliau ymarferol i gyfranogwyr. Rydym yn ymdrin ag ystod eang o bynciau, gan gynnwys dadansoddi data genomig, dehongli amrywiadau genetig, ac ystyriaethau moesegol mewn genomeg.',
          'Rydym hefyd yn cynnig rhaglenni hyfforddi wedi"u teilwra i ddiwallu anghenion penodol gwahanol sefydliadau a sefydliadau. Mae ein hyfforddwyr arbenigol yn gweithio\'n agos gyda chleientiaid i ddatblygu a chyflwyno rhaglenni sydd wedi\'u teilwra i\'w nodau a\'u hamcanion penodol.'
        ],
        images: [
          { src: educationMainImage, alt: 'Hyfforddiant Proffesiynol' },
        ],
      },
      {
        title: 'Ymgyrch Gyhoeddus',
        paragraphs: [
          'Rhaglenni cymunedol sy"n dod â genomeg yn fwy hygyrch, gan gynnwys darlithoedd cyhoeddus, gweithdai rhyngweithiol a digwyddiadau cydweithredol i hyrwyddo llythrennedd gwyddonol.',
          'Credwn ei bod yn bwysig gwneud genomeg yn hygyrch i bawb, ac mae ein rhaglenni allgymorth cyhoeddus wedi"u cynllunio i wneud hynny. Rydym yn gweithio gydag ysgolion, grwpiau cymunedol, a sefydliadau eraill i gyflwyno rhaglenni diddorol a llawn gwybodaeth sydd wedi"u teilwra i\'r gynulleidfa benodol.',
          'Mae ein rhaglenni yn ymdrin ag ystod eang o bynciau, o hanfodion DNA i\'r datblygiadau diweddaraf mewn ymchwil genomig. Rydym hefyd yn mynd i\'r afael â goblygiadau moesegol, cyfreithiol a chymdeithasol genomeg, ac rydym yn annog trafodaeth agored a dadl ynghylch y materion pwysig hyn.'
        ],
        images: [
          { src: educationWorkshopImage, alt: 'Ymgyrch Gyhoeddus' },
        ],
      },
      {
        title: 'Partneriaethau Ysgol a Phrifysgol',
        paragraphs: [
          'Mentrau addysgol cydweithredol gydag sefydliadau academaidd i ysbrydoli"r genhedlaeth nesaf o ymchwilwyr genomig a gweithwyr gofal iechyd proffesiynol.',
          'Rydym yn gweithio\'n agos gydag ysgolion a phrifysgolion i ddatblygu a chyflwyno rhaglenni addysgol sy\'n cyd-fynd â\'r cwricwlwm ac sy\'n ysbrydoli myfyrwyr i ddilyn gyrfaoedd mewn genomeg. Rydym yn cynnig amrywiaeth o raglenni, gan gynnwys darlithoedd gwadd, gweithdai, a chyfleoedd mentora.',
          'Rydym hefyd yn darparu adnoddau a chefnogaeth i athrawon ac addysgwyr sydd â diddordeb mewn ymgorffori genomeg yn eu haddysgu. Ein nod yw helpu i adeiladu sylfaen gref mewn addysg genomeg ac i feithrin datblygiad y genhedlaeth nesaf o arweinwyr genomeg.'
        ],
        images: [
          { src: educationEngagementImage, alt: 'Partneriaethau Ysgol a Phrifysgol' },
        ],
      }
    ]
  }
};

const currentContent = content[lang];
---

<Layout metadata={metadata}>
  <section class="scroll-mt-16 px-4 py-16 mx-auto max-w-6xl lg:px-8 lg:py-20">
    <div class="mb-12 text-center">
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading text-red-500 dark:text-red-500">
        {currentContent.title}
      </h1>
      <p class="text-xl text-gray-600 dark:text-slate-400">
        {currentContent.overview}
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-1">
      {currentContent.sections.map((section) => (
        <div class="relative flex flex-col p-6 bg-white dark:bg-slate-900 rounded-lg shadow-lg">
          <h3 class="text-xl font-bold mb-2">{section.title}</h3>
          {section.paragraphs.map((paragraph) => (
            <p class="text-gray-600 dark:text-slate-400 mb-4">{paragraph}</p>
          ))}
          <div class="grid grid-cols-1 gap-4 mt-4">
            {section.images.map((image) => (
              <Image
                src={image.src}
                alt={image.alt}
                class="w-full object-cover rounded-lg"
              />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
