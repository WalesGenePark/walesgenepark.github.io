---
import Layout from '~/layouts/PageLayout.astro';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import type { MetaData } from '~/types/metaData';
import { languages } from '~/i18n/config';
import { Image } from 'astro:assets';

// Import images
import ngsMainImage from '~/assets/images/ngs-service.jpg';
import ngsLabImage from '~/assets/images/bioinformatics-service.jpg';
import ngsAnalysisImage from '~/assets/images/education-service.jpg';

export function getStaticPaths() {
  return languages.map((lang) => ({
    params: { lang },
  }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const metadata: MetaData = {
  title: t('nav.services') + ' - NGS',
  description: 'Comprehensive Next Generation Sequencing Services',
  alternateLinks: [
    {
      href: `/${lang === 'en' ? 'cy' : 'en'}/services/ngs`,
      hreflang: lang === 'en' ? 'cy' : 'en',
    },
  ],
};

const content = {
  en: {
    title: 'Next Generation Sequencing (NGS) Services',
    overview: 'Our state-of-the-art Next Generation Sequencing (NGS) services provide cutting-edge genomic analysis for research and clinical applications.',
    sections: [
      {
        title: 'Advanced Sequencing Technologies',
        paragraphs: [
          'We utilize the latest NGS platforms to deliver high-quality, comprehensive genomic data.',
          'Our advanced technologies enable precise and rapid sequencing across various genomic applications.',
          'We offer a wide range of sequencing platforms, including Illumina NovaSeq, HiSeq, and MiSeq, as well as PacBio Sequel II for long-read sequencing. This allows us to tailor our services to meet the specific needs of each project, whether it requires high throughput, deep coverage, or long-range genomic information.'
        ],
        images: [
          { src: ngsMainImage, alt: 'Advanced Sequencing Technologies' },
        ],
      },
      {
        title: 'Comprehensive Genomic Analysis',
        paragraphs: [
          'From whole genome sequencing to targeted panel analysis, we offer a wide range of sequencing services tailored to your specific research or clinical needs.',
          'Our services include whole exome sequencing, RNA sequencing, ChIP-sequencing, and metagenomics. We also provide custom solutions for unique research questions. Our expert team works closely with researchers and clinicians to design and execute experiments that deliver meaningful and actionable results.',
          'We are committed to providing comprehensive support throughout the entire sequencing process, from initial consultation and experimental design to data generation and analysis. Our goal is to ensure that our clients receive the highest quality data and the most insightful interpretations.'
        ],
        images: [
          { src: ngsLabImage, alt: 'Comprehensive Genomic Analysis' },
        ],
      },
      {
        title: 'Expert Data Interpretation',
        paragraphs: [
          'Our team of expert bioinformaticians and geneticists provide in-depth analysis and interpretation of sequencing data, ensuring meaningful insights for researchers and clinicians.',
          'We utilize state-of-the-art bioinformatics pipelines and tools to process and analyze sequencing data, delivering accurate and reliable results. Our team has extensive experience in variant calling, annotation, pathway analysis, and other advanced analytical techniques.',
          'We provide detailed reports and visualizations that help our clients understand their data and make informed decisions. We also offer consultation services to discuss the findings and their implications for research or clinical practice.'
        ],
        images: [
          { src: ngsAnalysisImage, alt: 'Expert Data Interpretation' },
        ],
      }
    ]
  },
  cy: {
    title: 'Gwasanaethau Dilyniannu Cenhedlaeth Nesaf (NGS)',
    overview: 'Mae ein gwasanaethau Dilyniannu Cenhedlaeth Nesaf (NGS) o"r radd flaenaf yn darparu dadansoddiad genomig arloesol ar gyfer ymchwil a chymwysiadau clinigol.',
    sections: [
      {
        title: 'Technolegau Dilyniannu Uwch',
        paragraphs: [
          'Rydym yn defnyddio"r platfformau NGS diweddaraf i ddarparu data genomig cynhwysfawr o ansawdd uchel.',
          'Mae ein technolegau uwch yn galluogi dilyniannu manwl a chyflym ar draws gwahanol gymwysiadau genomig.',
          'Rydym yn cynnig amrywiaeth eang o blatfformau dilyniannu, gan gynnwys Illumina NovaSeq, HiSeq, a MiSeq, yn ogystal â PacBio Sequel II ar gyfer dilyniannu darlleniadau hir. Mae hyn yn ein galluogi i deilwra ein gwasanaethau i ddiwallu anghenion penodol pob prosiect, p\'un a oes angen trwybwn uchel, sylw dwfn, neu wybodaeth genomig ystod hir arno.'
        ],
        images: [
          { src: ngsMainImage, alt: 'Technolegau Dilyniannu Uwch' },
        ],
      },
      {
        title: 'Dadansoddiad Genomig Cynhwysfawr',
        paragraphs: [
          'O ddilyniannu"r genom cyfan i ddadansoddiad panel wedi"i dargedu, rydym yn cynnig ystod eang o wasanaethau dilyniannu wedi"u teilwra i"ch anghenion ymchwil neu glinigol penodol.',
          'Mae ein gwasanaethau yn cynnwys dilyniannu ecson cyfan, dilyniannu RNA, ChIP-sequencing, a metagenomeg. Rydym hefyd yn darparu atebion pwrpasol ar gyfer cwestiynau ymchwil unigryw. Mae ein tîm arbenigol yn gweithio\'n agos gydag ymchwilwyr a chlinigwyr i ddylunio a gweithredu arbrofion sy\'n darparu canlyniadau ystyrlon a gweithredadwy.',
          'Rydym wedi ymrwymo i ddarparu cefnogaeth gynhwysfawr trwy gydol y broses ddilyniannu gyfan, o ymgynghoriad cychwynnol a dyluniad arbrofol i gynhyrchu data a dadansoddi. Ein nod yw sicrhau bod ein cleientiaid yn derbyn y data o\'r ansawdd uchaf a\'r dehongliadau mwyaf craff.'
        ],
        images: [
          { src: ngsLabImage, alt: 'Dadansoddiad Genomig Cynhwysfawr' },
        ],
      },
      {
        title: 'Dehongli Data Arbenigol',
        paragraphs: [
          'Mae ein tîm o fiowybodegwyr a genetegwyr arbenigol yn darparu dadansoddiad a dehongliad manwl o ddata dilyniannu, gan sicrhau mewnwelediadau ystyrlon i ymchwilwyr a chlinigwyr.',
          'Rydym yn defnyddio piblinellau a theclynnau biowybodeg o\'r radd flaenaf i brosesu a dadansoddi data dilyniannu, gan ddarparu canlyniadau cywir a dibynadwy. Mae gan ein tîm brofiad helaeth mewn galw amrywiolion, anodi, dadansoddi llwybrau, a thechnegau dadansoddol uwch eraill.',
          'Rydym yn darparu adroddiadau a delweddu manwl sy\'n helpu ein cleientiaid i ddeall eu data a gwneud penderfyniadau gwybodus. Rydym hefyd yn cynnig gwasanaethau ymgynghori i drafod y canfyddiadau a\'u goblygiadau ar gyfer ymchwil neu ymarfer clinigol.'
        ],
        images: [
          { src: ngsAnalysisImage, alt: 'Dehongli Data Arbenigol' },
        ],
      }
    ]
  }
};

const currentContent = content[lang];
---

<Layout metadata={metadata}>
  <section class="scroll-mt-16 px-4 py-16 mx-auto max-w-6xl lg:px-8 lg:py-20">
    <div class="mb-12 text-center">
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading text-red-500 dark:text-red-500">
        {currentContent.title}
      </h1>
      <p class="text-xl text-gray-600 dark:text-slate-400">
        {currentContent.overview}
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-1">
      {currentContent.sections.map((section) => (
        <div class="relative flex flex-col p-6 bg-white dark:bg-slate-900 rounded-lg shadow-lg">
          <h3 class="text-xl font-bold mb-2">{section.title}</h3>
          {section.paragraphs.map((paragraph) => (
            <p class="text-gray-600 dark:text-slate-400 mb-4">{paragraph}</p>
          ))}
          <div class="grid grid-cols-1 gap-4 mt-4">
            {section.images.map((image) => (
              <Image
                src={image.src}
                alt={image.alt}
                class="w-full object-cover rounded-lg"
              />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
