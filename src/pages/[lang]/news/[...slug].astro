---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import { getAlternateSection, getSectionTitle } from '~/i18n/routes';
import type { LanguageCode } from '~/i18n/routes';
import type { NewsEntry } from '~/types/content';

export async function getStaticPaths() {
  const entries = await getCollection('news');
  const paths: Array<{
    params: { lang: string; slug: string };
    props: { entry: NewsEntry };
  }> = [];

  for (const entry of entries) {
    const [lang, ...slugParts] = entry.slug.split('/');

    if (lang === 'en' || lang === 'cy') {
      paths.push({
        params: {
          lang,
          slug: slugParts.join('/'),
        },
        props: { entry } as { entry: NewsEntry },
      });
    }
  }

  return paths;
}

interface Props {
  entry: NewsEntry;
}

const { lang, slug } = Astro.params;
const { entry } = Astro.props as Props;

if (!entry || !lang) {
  return Astro.redirect(`/${lang || 'en'}/404`);
}

const section = 'news';
const alternateSection = getAlternateSection(section, lang as LanguageCode);
const sectionTitle = getSectionTitle(section, lang as LanguageCode);

const metadata = {
  title: `${entry.data.title} | ${sectionTitle}`,
  description: entry.data.description || '',
  alternateLinks: [
    {
      href: `/${lang === 'en' ? 'cy' : 'en'}/${alternateSection}/${slug}`,
      hreflang: lang === 'en' ? 'cy' : 'en',
    },
  ],
  openGraph: {
    title: entry.data.title,
    description: entry.data.description || '',
    type: 'article',
    url: `${Astro.site}${lang}/news/${slug}`,
  },
};

const rendered = await entry.render();
---

<Layout metadata={metadata}>
  <article class="mx-auto max-w-4xl px-4 py-16 lg:py-20">
    <div class="mb-10">
      <h1 class="text-center font-bold leading-tighter tracking-tighter font-heading text-4xl md:text-5xl">
        {entry.data.title}
      </h1>
    </div>
    {
      'image' in entry.data && entry.data.image && (
        <img
          src={entry.data.image}
          class="mx-auto rounded-md shadow-lg mb-6"
          alt={entry.data.description || ''}
          loading="lazy"
        />
      )
    }
    <div class="mx-auto prose dark:prose-invert max-w-4xl">
      {rendered.Content}
    </div>
  </article>
</Layout>
