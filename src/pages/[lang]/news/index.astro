---
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import { Icon } from 'astro-icon/components';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'cy' } },
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const metadata = {
  title: t('nav.news'),
};

// Get news for current language
const news = await getCollection('news', ({ id }) => {
  return id.startsWith(lang + '/');
});

// Sort news by publishDate
const sortedNews = news.sort((a, b) => {
  return new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
});

function formatDate(date: Date, lang: string): string {
  const options: Intl.DateTimeFormatOptions = {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  };
  return date.toLocaleDateString(lang === 'cy' ? 'cy-GB' : 'en-GB', options);
}
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-6xl">
    <div class="mb-8">
      <h1 class="text-4xl font-bold mb-2">{t('nav.news')}</h1>
      <p class="text-gray-600 dark:text-gray-400">
        {sortedNews.length} {lang === 'en' ? 'articles' : 'erthyglau'}
      </p>
    </div>

    <div class="space-y-8">
      {sortedNews.map((article) => {
        const date = new Date(article.data.publishDate);
        // Remove language prefix from slug
        const slug = article.slug.split('/')[1];

        return (
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
            <a href={`/${lang}/news/${slug}`} class="block p-6">
              <div class="flex items-start space-x-4">
                {article.data.image && (
                  <div class="flex-shrink-0 w-48 h-32 relative">
                    <img
                      src={article.data.image}
                      alt={article.data.title}
                      class="absolute inset-0 w-full h-full object-cover rounded-lg"
                    />
                  </div>
                )}

                <div class="flex-grow">
                  <h2 class="text-2xl font-bold mb-2 group-hover:text-primary">
                    {article.data.title}
                  </h2>
                  
                  <div class="flex items-center text-gray-600 dark:text-gray-400 mb-4">
                    <Icon name="tabler:calendar" class="w-4 h-4 mr-2" />
                    <span class="text-sm">{formatDate(date, lang)}</span>

                    {article.data.author && (
                      <>
                        <span class="mx-2">•</span>
                        <Icon name="tabler:user" class="w-4 h-4 mr-2" />
                        <span class="text-sm">{article.data.author}</span>
                      </>
                    )}
                  </div>

                  {article.data.description && (
                    <p class="text-gray-600 dark:text-gray-400">
                      {article.data.description}
                    </p>
                  )}
                </div>

                <div class="flex-shrink-0">
                  <Icon name="tabler:chevron-right" class="w-6 h-6 text-gray-400" />
                </div>
              </div>
            </a>
          </div>
        );
      })}
    </div>
  </section>
</Layout>
