---
import Layout from '~/layouts/PageLayout.astro';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'cy' } },
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const metadata = {
  title: t('nav.contact'),
};

const content = {
  title: 'Cysylltu â Ni',
  description: 'Cysylltwch â Parc Genynnau Cymru. Rydym yma i helpu gyda\'ch cwestiynau am feddygaeth genomig ac ymchwil.',
  address: {
    title: 'Cyfeiriad',
    line1: 'Parc Genynnau Cymru',
    line2: 'Prifysgol Caerdydd',
    line3: 'Parc y Mynydd Bychan',
    line4: 'Caerdydd CF14 4XN'
  },
  email: {
    title: 'E-bost',
    value: 'walesgenepark@cardiff.ac.uk'
  },
  phone: {
    title: 'Ffôn',
    value: '+44 (0)29 2074 4204'
  }
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-8 font-heading">
      {content.title}
    </h1>
    
    <p class="text-xl text-gray-600 dark:text-gray-400 mb-12">
      {content.description}
    </p>

    <div class="grid md:grid-cols-2 gap-8">
      <div class="bg-white dark:bg-gray-800 p-8 rounded-lg shadow-md">
        <h2 class="text-2xl font-semibold mb-4">{content.address.title}</h2>
        <address class="not-italic">
          <p>{content.address.line1}</p>
          <p>{content.address.line2}</p>
          <p>{content.address.line3}</p>
          <p>{content.address.line4}</p>
        </address>
      </div>

      <div class="bg-white dark:bg-gray-800 p-8 rounded-lg shadow-md">
        <div class="mb-6">
          <h2 class="text-2xl font-semibold mb-2">{content.email.title}</h2>
          <a href={`mailto:${content.email.value}`} class="text-primary hover:underline">
            {content.email.value}
          </a>
        </div>

        <div>
          <h2 class="text-2xl font-semibold mb-2">{content.phone.title}</h2>
          <a href={`tel:${content.phone.value}`} class="text-primary hover:underline">
            {content.phone.value}
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
