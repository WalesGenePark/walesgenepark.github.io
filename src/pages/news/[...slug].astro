---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
  const newsEntries = await getCollection('news');
  return newsEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
    <div class="max-w-3xl mx-auto">
      {entry.data.image && (
        <img 
          src={entry.data.image} 
          class="w-full rounded-lg shadow-lg mb-6" 
          alt={entry.data.title}
        />
      )}
      
      <h1 class="text-4xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
        {entry.data.title}
      </h1>

      <div class="flex items-center mb-6">
        <div class="flex items-center">
          <Icon name="tabler:news" class="w-4 h-4 mr-2 text-red-600" />
          <span class="text-sm text-gray-600 dark:text-gray-400">
            {entry.data.date.toLocaleDateString('en-GB', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })}
          </span>
        </div>
        <span class="mx-3 text-gray-400">•</span>
        <span class="bg-blue-100 text-blue-800 dark:bg-blue-900/20 dark:text-blue-400 text-sm font-medium px-2.5 py-0.5 rounded">
          News
        </span>
      </div>

      <div class="prose prose-lg max-w-none dark:prose-invert mb-6">
        <Content />
      </div>

      <div class="flex justify-between items-center mt-8">
        <a href="/news" class="inline-flex items-center text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300">
          <Icon name="tabler:arrow-left" class="w-4 h-4 mr-1" />
          Back to News
        </a>
      </div>
    </div>
  </section>
</Layout>
