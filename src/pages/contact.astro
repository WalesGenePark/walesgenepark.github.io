---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact Wales Gene Park',
  description: 'Get in touch with Wales Gene Park for genomics research, education, and support.',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="Contact Us"
    title="Get in Touch with Wales Gene Park"
    subtitle="Have questions about genomics research, education, or support? We're here to help!"
  />

  <ContactUs
    id="form"
    title="Send Us a Message"
    subtitle="Whether you're a researcher, healthcare professional, student, or member of the public, we're here to assist you with any questions about genomics and our services."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
        placeholder: 'Enter your name',
        required: true,
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
        placeholder: 'Enter your email address',
        required: true,
      },
      {
        type: 'select',
        name: 'enquiry',
        label: 'Type of Enquiry',
        placeholder: 'Select an option',
        options: [
          { value: 'research', label: 'Research Collaboration' },
          { value: 'education', label: 'Education & Training' },
          { value: 'events', label: 'Events & Workshops' },
          { value: 'support', label: 'Patient & Family Support' },
          { value: 'other', label: 'Other' }
        ],
        required: true,
      }
    ]}
    textarea={{
      label: 'Message',
      placeholder: 'Please provide details about your enquiry...',
      required: true,
    }}
    disclaimer={{
      label:
        'By submitting this form, you consent to Wales Gene Park processing your data in accordance with our privacy policy.',
    }}
    description="Our team aims to respond to all enquiries within 2 working days."
    btnLabel="Send Message"
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Ways to Connect"
    subtitle="Choose the most convenient way to reach us"
    columns={3}
    items={[
      {
        title: 'General Enquiries',
        description: 'For general questions about our services, research activities, or how we can help you.',
        icon: 'tabler:messages',
      },
      {
        title: 'Research & Collaboration',
        description: 'Interested in collaborating on genomics research or accessing our facilities? Contact our research team.',
        icon: 'tabler:dna',
      },
      {
        title: 'Education & Training',
        description: 'For information about our educational programs, workshops, and training opportunities.',
        icon: 'tabler:school',
      },
      {
        title: 'Phone',
        description: '+44 (0)29 2074 4204',
        icon: 'tabler:phone',
      },
      {
        title: 'Email',
        description: 'walesgenepark@wales.nhs.uk',
        icon: 'tabler:mail',
      },
      {
        title: 'Location',
        description: 'Institute of Medical Genetics, University Hospital of Wales, Heath Park, Cardiff, CF14 4XW',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>
