---
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { format } from 'date-fns';

const metadata = {
  title: 'Events | Wales Gene Park',
  description: 'Upcoming events, workshops, and conferences at Wales Gene Park.',
};

// Get all events
const allEvents = await getCollection('events');
const allNews = await getCollection('news');

// Combine events and news for the calendar
const calendarItems = [
  ...allEvents.map(event => ({
    type: 'event',
    title: event.data.title,
    startDate: new Date(event.data.startDate).toISOString(),
    endDate: new Date(event.data.endDate).toISOString(),
    description: event.data.description,
    slug: `/events/${event.slug}`
  })),
  ...allNews.map(news => ({
    type: 'news',
    title: news.data.title,
    startDate: new Date(news.data.date).toISOString(),
    endDate: new Date(news.data.date).toISOString(),
    description: news.data.description,
    slug: `/news/${news.slug}`
  }))
];

// Get current date
const today = new Date();
const currentMonth = today.getMonth();
const currentYear = today.getFullYear();

// Generate year options
const yearOptions = Array.from(
  { length: 10 }, 
  (_, i) => currentYear - 5 + i
);
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-6xl">
    <div class="mb-10 md:mx-auto text-center md:mb-12 max-w-3xl">
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading text-red-600 dark:text-red-400">
        Events Calendar
      </h1>
      <p class="text-xl text-gray-600 dark:text-slate-400">
        Discover upcoming events and news at Wales Gene Park
      </p>
    </div>

    <!-- Calendar Controls -->
    <div class="flex justify-between items-center mb-6">
      <div class="flex items-center space-x-4">
        <button 
          class="p-2 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-full transition-colors"
          id="prevMonth"
        >
          <Icon name="tabler:chevron-left" class="w-6 h-6" />
        </button>
        <h2 class="text-2xl font-semibold" id="currentMonthYear"></h2>
        <button 
          class="p-2 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-full transition-colors"
          id="nextMonth"
        >
          <Icon name="tabler:chevron-right" class="w-6 h-6" />
        </button>
      </div>
      <div class="flex space-x-4 items-center">
        <button
          class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors"
          id="todayButton"
        >
          Today
        </button>
        <select 
          class="bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-lg px-3 py-2"
          id="monthSelect"
        >
          <option value="0">January</option>
          <option value="1">February</option>
          <option value="2">March</option>
          <option value="3">April</option>
          <option value="4">May</option>
          <option value="5">June</option>
          <option value="6">July</option>
          <option value="7">August</option>
          <option value="8">September</option>
          <option value="9">October</option>
          <option value="10">November</option>
          <option value="11">December</option>
        </select>
        <select 
          class="bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-lg px-3 py-2"
          id="yearSelect"
        >
          {yearOptions.map(year => (
            <option value={year}>{year}</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Calendar Grid -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow overflow-hidden">
      <!-- Calendar Header -->
      <div class="grid grid-cols-7 gap-px bg-gray-200 dark:bg-gray-700 border-b border-gray-200 dark:border-gray-700">
        {['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map(day => (
          <div class="px-4 py-2 text-center font-semibold bg-white dark:bg-gray-800 text-red-600 dark:text-red-400">
            {day}
          </div>
        ))}
      </div>

      <!-- Calendar Body -->
      <div class="grid grid-cols-7 gap-px bg-gray-200 dark:bg-gray-700" id="calendarGrid">
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ calendarItems: calendarItems, currentMonth: currentMonth, currentYear: currentYear }}>
  // Store calendar state
  let displayMonth = currentMonth;
  let displayYear = currentYear;

  // Function to get days in month
  function getDaysInMonth(month, year) {
    return new Date(year, month + 1, 0).getDate();
  }

  // Function to get first day of month (0 = Sunday, 1 = Monday, etc.)
  function getFirstDayOfMonth(month, year) {
    return new Date(year, month, 1).getDay();
  }

  // Function to format date
  function formatDate(date) {
    return new Date(date).toLocaleTimeString('en-US', {
      hour: '2-digit',
      minute: '2-digit',
      hour12: false
    });
  }

  // Function to check if date is in the past
  function isDateInPast(date) {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    date.setHours(0, 0, 0, 0);
    return date < today;
  }

  // Function to generate calendar HTML
  function generateCalendarHTML(month, year) {
    const daysInMonth = getDaysInMonth(month, year);
    const firstDay = getFirstDayOfMonth(month, year);
    let html = '';

    // Add empty cells for days before the first day of the month
    for (let i = 0; i < firstDay; i++) {
      html += `<div class="min-h-[120px] bg-white dark:bg-gray-800 p-2 bg-gray-50 dark:bg-gray-900"></div>`;
    }

    // Add days of the month
    for (let day = 1; day <= daysInMonth; day++) {
      const currentDate = new Date(year, month, day);
      const isPast = isDateInPast(new Date(year, month, day));
      const dayItems = calendarItems.filter(item => {
        const itemDate = new Date(item.startDate);
        return itemDate.getDate() === day && 
               itemDate.getMonth() === month && 
               itemDate.getFullYear() === year;
      });

      html += `
        <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2 ${
          isPast ? 'opacity-50' : ''
        }">
          <div class="font-semibold mb-1 ${
            isPast ? 'text-gray-500 dark:text-gray-400' : ''
          }">${day}</div>
          <div class="space-y-1">
            ${dayItems.map(item => `
              <a 
                href="${item.slug}"
                class="block p-2 rounded hover:opacity-75 transition-opacity ${
                  item.type === 'event' 
                    ? 'bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700' 
                    : 'bg-blue-100 dark:bg-blue-900'
                } ${isPast ? 'opacity-75' : ''}"
              >
                ${item.type === 'event' ? `
                  <div class="text-red-600 dark:text-red-400 text-xs mb-1 ${
                    isPast ? 'opacity-75' : ''
                  }">
                    ${formatDate(item.startDate)} - ${formatDate(item.endDate)}
                  </div>
                ` : ''}
                <div class="font-medium text-xs ${
                  item.type === 'event' 
                    ? 'text-gray-900 dark:text-gray-100' 
                    : 'text-blue-800 dark:text-blue-200'
                } ${isPast ? 'opacity-75' : ''}">
                  ${item.title}
                </div>
              </a>
            `).join('')}
          </div>
        </div>
      `;
    }

    return html;
  }

  // Function to update calendar display
  function updateCalendarDisplay() {
    const monthYearDisplay = document.getElementById('currentMonthYear');
    const calendarGrid = document.getElementById('calendarGrid');
    const monthSelect = document.getElementById('monthSelect');
    const yearSelect = document.getElementById('yearSelect');

    if (monthYearDisplay && calendarGrid && monthSelect && yearSelect) {
      // Update display elements
      const date = new Date(displayYear, displayMonth);
      monthYearDisplay.textContent = date.toLocaleString('default', { 
        month: 'long', 
        year: 'numeric' 
      });
      monthSelect.value = displayMonth.toString();
      yearSelect.value = displayYear.toString();

      // Update calendar grid
      calendarGrid.innerHTML = generateCalendarHTML(displayMonth, displayYear);
    }
  }

  // Function to update calendar
  function updateCalendar() {
    const monthSelect = document.getElementById('monthSelect');
    const yearSelect = document.getElementById('yearSelect');
    
    if (monthSelect && yearSelect) {
      displayMonth = parseInt(monthSelect.value);
      displayYear = parseInt(yearSelect.value);
      updateCalendarDisplay();
    }
  }

  // Function to change month
  function changeMonth(delta) {
    displayMonth += delta;
    
    if (displayMonth > 11) {
      displayMonth = 0;
      displayYear++;
    } else if (displayMonth < 0) {
      displayMonth = 11;
      displayYear--;
    }
    
    updateCalendarDisplay();
  }

  // Function to go to current month
  function goToCurrentMonth() {
    const today = new Date();
    displayMonth = today.getMonth();
    displayYear = today.getFullYear();
    updateCalendarDisplay();
  }

  // Initialize calendar immediately and after DOM content loaded
  function initializeCalendar() {
    // Set initial values for dropdowns
    const monthSelect = document.getElementById('monthSelect');
    const yearSelect = document.getElementById('yearSelect');
    
    if (monthSelect && yearSelect) {
      monthSelect.value = displayMonth.toString();
      yearSelect.value = displayYear.toString();
    }
    
    // Update the display
    updateCalendarDisplay();

    // Add event listeners
    const prevMonthBtn = document.getElementById('prevMonth');
    const nextMonthBtn = document.getElementById('nextMonth');
    const todayBtn = document.getElementById('todayButton');

    if (prevMonthBtn) {
      prevMonthBtn.addEventListener('click', () => changeMonth(-1));
    }
    if (nextMonthBtn) {
      nextMonthBtn.addEventListener('click', () => changeMonth(1));
    }
    if (todayBtn) {
      todayBtn.addEventListener('click', goToCurrentMonth);
    }
    if (monthSelect) {
      monthSelect.addEventListener('change', updateCalendar);
    }
    if (yearSelect) {
      yearSelect.addEventListener('change', updateCalendar);
    }
  }

  // Initialize immediately
  initializeCalendar();

  // Also initialize when DOM is fully loaded (backup)
  document.addEventListener('DOMContentLoaded', initializeCalendar);

  // Add a backup initialization for when the page is fully loaded
  window.addEventListener('load', initializeCalendar);
</script>
