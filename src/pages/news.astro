---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

const allNews = await getCollection('news');
const allEvents = await getCollection('events');

// Combine news and events into a single array
const combinedItems = [
  ...allNews.map(item => ({
    ...item,
    type: 'news',
    date: item.data.date
  })),
  ...allEvents.map(item => ({
    ...item,
    type: 'event',
    date: item.data.startDate
  }))
];

// Sort combined items by date
const sortedItems = combinedItems.sort((a, b) => b.date.getTime() - a.date.getTime());

const metadata = {
  title: 'News & Events',
  description: 'Stay updated with the latest news and upcoming events from Wales Gene Park.',
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-6xl">
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-red-600 dark:text-red-400">News & Events</h1>
    </div>
    
    <div class="flex justify-center mb-8">
      <div class="inline-flex rounded-lg border border-gray-200 dark:border-gray-700">
        <button
          class="px-4 py-2 rounded-l-lg bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-none transition-colors filter-btn active"
          data-filter="all"
        >
          All
        </button>
        <button
          class="px-4 py-2 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-none transition-colors filter-btn"
          data-filter="news"
        >
          News
        </button>
        <button
          class="px-4 py-2 rounded-r-lg bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-none transition-colors filter-btn"
          data-filter="event"
        >
          Events
        </button>
      </div>
    </div>
    
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3" id="items-grid">
      {
        sortedItems.map((item) => (
          <div class={`bg-white dark:bg-slate-900 rounded-lg shadow-lg overflow-hidden item-card ${item.type}`} data-type={item.type}>
            {item.data.image && (
              <img
                src={item.data.image}
                alt={item.data.title}
                class="w-full h-48 object-cover"
              />
            )}
            <div class="p-6">
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm font-medium text-red-600 dark:text-red-400">
                  {item.type === 'event' ? (
                    <>
                      <Icon name="tabler:calendar-event" class="inline-block w-4 h-4 mr-1" />
                      {item.date.toLocaleDateString('en-GB', {
                        day: 'numeric',
                        month: 'long',
                        year: 'numeric',
                      })}
                    </>
                  ) : (
                    <>
                      <Icon name="tabler:news" class="inline-block w-4 h-4 mr-1" />
                      {item.date.toLocaleDateString('en-GB', {
                        day: 'numeric',
                        month: 'long',
                        year: 'numeric',
                      })}
                    </>
                  )}
                </span>
                <span class={`text-sm font-medium px-2 py-1 rounded-full ${
                  item.type === 'event' 
                    ? 'bg-red-100 text-red-800 dark:bg-red-900/20 dark:text-red-400'
                    : 'bg-blue-100 text-blue-800 dark:bg-blue-900/20 dark:text-blue-400'
                }`}>
                  {item.type === 'event' ? 'Event' : 'News'}
                </span>
              </div>
              <h2 class="text-xl font-bold mb-2 text-gray-900 dark:text-gray-100">
                {item.data.title}
              </h2>
              <p class="text-gray-700 dark:text-gray-300 mb-4">
                {item.data.description}
              </p>
              {item.data.readMoreLink && (
                <a
                  href={item.data.readMoreLink}
                  class="inline-flex items-center text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300"
                >
                  Read more
                  <Icon name="tabler:arrow-right" class="w-4 h-4 ml-1" />
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Layout>

<script>
  // Filter functionality
  const filterButtons = document.querySelectorAll('.filter-btn');
  const itemCards = document.querySelectorAll('.item-card');

  function filterItems(filterValue) {
    itemCards.forEach(card => {
      if (filterValue === 'all' || card.dataset.type === filterValue) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
  }

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      // Update active state
      filterButtons.forEach(btn => btn.classList.remove('active', 'bg-red-50', 'dark:bg-red-900/20', 'text-red-600', 'dark:text-red-400'));
      button.classList.add('active', 'bg-red-50', 'dark:bg-red-900/20', 'text-red-600', 'dark:text-red-400');
      
      // Filter items
      const filterValue = button.dataset.filter;
      filterItems(filterValue);
    });
  });

  // Set initial active state
  filterButtons[0].classList.add('active', 'bg-red-50', 'dark:bg-red-900/20', 'text-red-600', 'dark:text-red-400');
</script>

<style>
  .filter-btn.active {
    background-color: rgb(254 242 242);
    color: rgb(220 38 38);
  }
  
  @media (prefers-color-scheme: dark) {
    .filter-btn.active {
      background-color: rgba(220, 38, 38, 0.1);
      color: rgb(248 113 113);
    }
  }
</style>
